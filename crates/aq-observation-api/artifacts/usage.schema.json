{
  "$defs": {
    "AccountingCompleteness": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "incomplete",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/Text"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "complete_for_policy",
              "type": "string"
            },
            "policy": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "policy"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "attempt_generation": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "attempt_id": {
          "format": "uuid",
          "type": "string"
        },
        "lineage_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        },
        "task_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "task_id",
        "lineage_id",
        "attempt_id",
        "attempt_generation",
        "session"
      ],
      "type": "object"
    },
    "Cost": {
      "description": "An estimate is explicitly not an invoice. Reported charges still require\nprovenance/owner verification; no wire claim authorizes double-billing.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UnknownReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "amount_microunits": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            "currency": {
              "$ref": "#/$defs/Text"
            },
            "kind": {
              "const": "provider_reported",
              "type": "string"
            },
            "receipt": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "amount_microunits",
            "currency",
            "receipt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allocation_policy": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "amount_microunits": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            "basis": {
              "$ref": "#/$defs/EstimateBasis"
            },
            "currency": {
              "$ref": "#/$defs/Text"
            },
            "kind": {
              "const": "non_invoice_estimate",
              "type": "string"
            },
            "rate_card": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "amount_microunits",
            "currency",
            "rate_card",
            "basis",
            "allocation_policy"
          ],
          "type": "object"
        }
      ]
    },
    "Counter": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UnknownReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "Counters": {
      "additionalProperties": false,
      "properties": {
        "cache_read": {
          "$ref": "#/$defs/Counter"
        },
        "cache_write": {
          "$ref": "#/$defs/Counter"
        },
        "input": {
          "$ref": "#/$defs/Counter"
        },
        "output": {
          "$ref": "#/$defs/Counter"
        },
        "reasoning": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write",
        "reasoning"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "EstimateBasis": {
      "enum": [
        "token_rates",
        "subscription_allocation",
        "local_model_allocation"
      ],
      "type": "string"
    },
    "SessionIdentity": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "assignment_generation": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            "attempt_id": {
              "format": "uuid",
              "type": "string"
            },
            "boot_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "remote",
              "type": "string"
            },
            "node_id": {
              "format": "uuid",
              "type": "string"
            },
            "session_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "node_id",
            "boot_id",
            "attempt_id",
            "assignment_generation",
            "session_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authority_id": {
              "format": "uuid",
              "type": "string"
            },
            "generation": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "central",
              "type": "string"
            },
            "session_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "authority_id",
            "session_id",
            "generation"
          ],
          "type": "object"
        }
      ]
    },
    "Text": {
      "description": "Nonempty UTF-8 text, at most 512 bytes; no control characters.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "UnknownReason": {
      "enum": [
        "not_reported",
        "unsupported",
        "source_gap",
        "not_applicable",
        "incomplete"
      ],
      "type": "string"
    },
    "UsageView": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "$ref": "#/$defs/AccountingCompleteness"
        },
        "costs": {
          "items": {
            "$ref": "#/$defs/Cost"
          },
          "type": "array"
        },
        "counter_generation": {
          "format": "uint64",
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "counters": {
          "$ref": "#/$defs/Counters"
        },
        "ledger_revision": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "ledger_revision",
        "counters",
        "costs",
        "completeness"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "canonical_calls": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "checked_at_ms": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "incomplete_calls": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "known_category_subtotals": {
      "description": "Order: input, output, cache read, cache write, reasoning. Categories may overlap.",
      "items": {
        "format": "uint64",
        "maximum": 18446744073709551615,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "last_recorded_at_ms": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "revision": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "unresolved_events": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/UsageView"
    }
  },
  "required": [
    "schema_version",
    "binding",
    "revision",
    "checked_at_ms",
    "usage",
    "known_category_subtotals",
    "canonical_calls",
    "incomplete_calls",
    "unresolved_events"
  ],
  "title": "SessionUsage",
  "type": "object",
  "x-max-wire-bytes": 16384
}
