{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "GuardianIdentity": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "$ref": "#/$defs/LaunchIntent"
        },
        "machine_boot_id": {
          "format": "uuid",
          "type": "string"
        },
        "nonce": {
          "description": "Physical guardian nonce allocated by aq-session-host after permission to\nlaunch. This is distinct from Request.guardian_id's pre-grant owner.",
          "format": "uuid",
          "type": "string"
        },
        "pid_namespace": {
          "$ref": "#/$defs/Label"
        },
        "process": {
          "$ref": "#/$defs/ProcessEvidence"
        }
      },
      "required": [
        "intent",
        "nonce",
        "process",
        "machine_boot_id",
        "pid_namespace"
      ],
      "type": "object"
    },
    "Label": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "LaunchBinding": {
      "additionalProperties": false,
      "properties": {
        "assignment_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "attempt_id": {
          "format": "uuid",
          "type": "string"
        },
        "execution_spec_digest": {
          "$ref": "#/$defs/Digest"
        },
        "graph_access_profile_digest": {
          "$ref": "#/$defs/Digest"
        },
        "launch_manifest_digest": {
          "$ref": "#/$defs/Digest"
        },
        "offer_id": {
          "format": "uuid",
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        }
      },
      "required": [
        "session",
        "schema_version",
        "offer_id",
        "attempt_id",
        "assignment_generation",
        "execution_spec_digest",
        "launch_manifest_digest",
        "graph_access_profile_digest"
      ],
      "type": "object"
    },
    "LaunchIntent": {
      "additionalProperties": false,
      "properties": {
        "configuration_digest": {
          "$ref": "#/$defs/Digest"
        },
        "launch_id": {
          "format": "uuid",
          "type": "string"
        },
        "manifest_digest": {
          "$ref": "#/$defs/Digest"
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        }
      },
      "required": [
        "launch_id",
        "session",
        "manifest_digest",
        "configuration_digest"
      ],
      "type": "object"
    },
    "PaneIdentity": {
      "additionalProperties": false,
      "properties": {
        "pane": {
          "$ref": "#/$defs/ProcessEvidence"
        },
        "pane_id": {
          "$ref": "#/$defs/Label"
        },
        "server": {
          "$ref": "#/$defs/ProcessEvidence"
        },
        "session_name": {
          "$ref": "#/$defs/Label"
        }
      },
      "required": [
        "server",
        "pane",
        "pane_id",
        "session_name"
      ],
      "type": "object"
    },
    "ProcessEvidence": {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start_ticks": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pid",
        "start_ticks"
      ],
      "type": "object"
    },
    "RunningObservation": {
      "additionalProperties": false,
      "description": "The exact public HostObservation JSON shape, restricted to a genuine live\nRunning snapshot. Unknown/starting/stopped reports cannot decode as this type.",
      "properties": {
        "guardian": {
          "$ref": "#/$defs/GuardianIdentity"
        },
        "kernel_wait_echild": {
          "type": "boolean"
        },
        "observed_boot_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pane": {
          "$ref": "#/$defs/PaneIdentity"
        },
        "permit_deadline_boot_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "permit_sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/RunningPhase"
        },
        "reaped_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "root_status": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "stop_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Label"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "guardian",
        "phase",
        "pane",
        "permit_sequence",
        "permit_deadline_boot_ms",
        "observed_boot_ms",
        "reaped_count",
        "kernel_wait_echild"
      ],
      "type": "object"
    },
    "RunningPhase": {
      "enum": [
        "running"
      ],
      "type": "string"
    },
    "SessionIdentity": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "assignment_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "attempt_id": {
              "format": "uuid",
              "type": "string"
            },
            "boot_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "remote",
              "type": "string"
            },
            "node_id": {
              "format": "uuid",
              "type": "string"
            },
            "session_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "node_id",
            "boot_id",
            "attempt_id",
            "assignment_generation",
            "session_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authority_id": {
              "format": "uuid",
              "type": "string"
            },
            "generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "central",
              "type": "string"
            },
            "session_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "authority_id",
            "session_id",
            "generation"
          ],
          "type": "object"
        }
      ]
    },
    "Text": {
      "description": "Nonempty UTF-8 text, at most 512 bytes; no control characters.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/LaunchBinding"
    },
    "grant_id": {
      "format": "uuid",
      "type": "string"
    },
    "guardian_id": {
      "description": "Logical launch/reservation owner established before the grant.",
      "format": "uuid",
      "type": "string"
    },
    "journal_digest": {
      "$ref": "#/$defs/Digest"
    },
    "journal_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "launch_id": {
      "format": "uuid",
      "type": "string"
    },
    "observation": {
      "$ref": "#/$defs/RunningObservation"
    },
    "observation_digest": {
      "$ref": "#/$defs/Digest"
    },
    "operation_id": {
      "description": "The original durable started operation, never a new ID on retry/renewal.",
      "format": "uuid",
      "type": "string"
    },
    "qualification": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "reservation_id": {
      "format": "uuid",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "binding",
    "grant_id",
    "guardian_id",
    "launch_id",
    "reservation_id",
    "runtime",
    "qualification",
    "journal_revision",
    "journal_digest",
    "observation",
    "observation_digest"
  ],
  "title": "Request",
  "type": "object"
}
