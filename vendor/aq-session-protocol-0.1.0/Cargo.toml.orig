[package]
name = "aq-session-protocol"
version = "0.1.0"
edition = "2024"
publish = false
description = "Pure, versioned AQ profiled-launch and terminal contracts"
[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
schemars = { version = "1", features = ["uuid1"] }
sha2 = "0.10"
thiserror = "2"
uuid = { version = "1", features = ["serde"] }
