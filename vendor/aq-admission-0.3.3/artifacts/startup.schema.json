        },
        "cli_version": {
          "$ref": "#/$defs/Text"
        },
        "environment": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "harness": {
          "$ref": "#/$defs/Text"
        },
        "required_capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "maxItems": 128,
          "type": "array"
        }
      },
      "required": [
        "harness",
        "cli_version",
        "adapter",
        "environment",
        "required_capabilities"
      ],
      "type": "object"
    },
    "InputSpan": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "artifact",
        "offset",
        "bytes"
      ],
      "type": "object"
    },
    "LaunchBinding": {
      "additionalProperties": false,
      "properties": {
        "assignment_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "attempt_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "execution_spec_digest": {
          "$ref": "#/$defs/Digest"
        },
        "graph_access_profile_digest": {
          "$ref": "#/$defs/Digest"
        },
        "launch_manifest_digest": {
          "$ref": "#/$defs/Digest"
        },
        "offer_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        }
      },
      "required": [
        "session",
        "schema_version",
        "offer_id",
        "attempt_id",
        "assignment_generation",
        "execution_spec_digest",
        "launch_manifest_digest",
