{
  "$comment": "Additive native startup delivery. Validate descriptor content-address pin in manifest.modules, retained roles/bytes, exact ordered Startup coverage, nonoverlapping byte spans, actual UTF8/slice/whole digests, checked token/output budgets and current retention in code. Qualified counting/renderer evidence and current execution authorization remain actual owner checks, not schema authority. Constituent Startup artifacts are delivered through this one payload and never independently appended. Frozen OfferedLaunch remains unchanged.",
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "source",
        "context",
        "outcome",
        "composition",
        "selection",
        "definition"
      ],
      "maxLength": 4096,
      "type": "string",
      "x-utf8-maxBytes": 4096
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "attempt_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "attempt_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "lineage_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "project_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        },
        "task_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        }
      },
      "required": [
        "project_id",
        "task_id",
        "lineage_id",
        "attempt_id",
        "attempt_generation",
        "session"
      ],
      "type": "object"
    },
    "BudgetBasis": {
      "enum": [
        "task_cumulative_estimated_cost",
        "task_cumulative_enforced_cost"
      ],
      "maxLength": 4096,
      "type": "string",
      "x-utf8-maxBytes": 4096
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "ContextDelivery": {
      "enum": [
        "startup",
        "on_demand"
      ],
      "maxLength": 4096,
      "type": "string",
      "x-utf8-maxBytes": 4096
    },
    "ContextPlan": {
      "additionalProperties": false,
      "properties": {
        "context_window_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/ContextRef"
          },
          "maxItems": 128,
          "type": "array"
        },
        "reserved_output_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "startup_byte_budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "startup_token_budget": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "references",
        "startup_token_budget",
        "startup_byte_budget",
        "reserved_output_tokens",
        "context_window_tokens"
      ],
      "type": "object"
    },
    "ContextRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "delivery": {
          "$ref": "#/$defs/ContextDelivery"
        },
        "provenance": {
          "$ref": "#/$defs/Text"
        },
        "required": {
          "type": "boolean"
        },
        "tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "artifact",
        "provenance",
        "delivery",
        "bytes",
        "tokens",
        "required"
      ],
      "type": "object"
    },
    "DeliveryClock": {
      "additionalProperties": false,
      "properties": {
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "server_time_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "valid_for_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "server_time_ms",
        "expires_at_ms",
        "valid_for_ms"
      ],
      "type": "object"
    },
    "Descriptor": {
      "additionalProperties": false,
      "description": "The renderer qualification binds the precise producer rendering and the\nadapter's byte-for-byte consumption, including any implicit model overhead.",
      "properties": {
        "implicit_tokens_upper_bound": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "payload": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "payload_bytes": {
          "format": "uint64",
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        },
        "payload_tokens_upper_bound": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "renderer_qualification": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "startup_inputs": {
          "items": {
            "$ref": "#/$defs/InputSpan"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "payload",
        "renderer_qualification",
        "startup_inputs",
        "payload_bytes",
        "payload_tokens_upper_bound",
        "implicit_tokens_upper_bound"
      ],
      "type": "object"
    },
    "Digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string",
      "x-utf8-maxBytes": 64
    },
    "Feature": {
      "enum": [
        "artifact_transfer_v1",
        "server_material_v1",
        "durable_host_journal_v1",
