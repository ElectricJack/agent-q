  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Additive native consumption envelope. The frozen OfferedLaunch wire remains\nuseful for compatibility replay; this explicit profile is required by the\nnew producer and its qualified worker consumer.",
