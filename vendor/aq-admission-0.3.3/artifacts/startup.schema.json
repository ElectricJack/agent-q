          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "project_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        },
        "source": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "task_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "task_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "session",
        "project_id",
        "project_revision",
        "graph_id",
        "task_id",
        "task_revision",
        "attempt_id",
        "assignment_generation",
