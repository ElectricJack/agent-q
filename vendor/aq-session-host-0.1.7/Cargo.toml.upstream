[package]
name = "aq-session-host"
version = "0.1.7"
edition = "2024"
publish = false
description = "Linux guarded tmux session host with independent expiring authority"
[dependencies]
aq-session-protocol = { path = "../aq-session-protocol", version = "=0.1.0" }
aq-terminal-relay-protocol = { path = "../../vendor/aq-terminal-relay-protocol-0.1.0", version = "=0.1.0" }
anyhow = "1"
chacha20poly1305 = "0.10"
libc = "0.2"
rand = "0.8"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sha2 = "0.10"
uuid = { version = "1", features = ["v4", "serde"] }
zeroize = "1"
[dev-dependencies]
tempfile = "3"
aq-responses-transport = { path = "../aq-responses-transport", version = "=0.1.0", features = ["test-support"] }
tokio = { version = "1", features = ["rt-multi-thread", "macros", "sync", "time", "net", "io-util"] }

[features]
test-support = []

[[bin]]
name = "aq-session-capsule-candidate"
path = "src/bin/aq-session-capsule-candidate.rs"
required-features = ["test-support"]
