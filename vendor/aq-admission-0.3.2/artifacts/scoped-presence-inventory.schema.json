{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "CredentialReference": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "revision": {
          "format": "uint64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "revision"
      ],
      "type": "object"
    },
    "Digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string",
      "x-utf8-byte-limit": 64
    },
    "Negotiation": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "qualification": {
          "$ref": "#/$defs/ArtifactRef",
          "properties": {
            "id": {
              "pattern": "^aq[.]scoped-material-presence-qualification/.+"
            }
          }
        }
      },
      "required": [
        "protocol",
        "qualification"
      ],
      "type": "object"
    },
    "Protocol": {
      "enum": [
        "aq.scoped-material-presence.v1"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty UTF-8 text, at most 512 bytes; no control characters.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string",
      "x-utf8-byte-limit": 512
    },
    "WorkerIdentity": {
      "additionalProperties": false,
      "properties": {
        "boot_id": {
          "format": "uuid",
          "type": "string"
        },
        "node_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "boot_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "identity": {
      "$ref": "#/$defs/WorkerIdentity"
    },
    "negotiation": {
      "$ref": "#/$defs/Negotiation"
    },
    "operation_id": {
      "format": "uuid",
      "type": "string"
    },
    "provisionable_only": {
      "description": "Explicitly NOT an installed or provider-availability assertion.",
      "items": {
        "$ref": "#/$defs/CredentialReference"
      },
      "maxItems": 32,
      "type": "array"
    },
    "qualifications": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "runtime": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "runtime_qualification": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "sequence": {
      "format": "uint64",
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "ttl_ms": {
      "format": "uint64",
      "maximum": 30000,
      "minimum": 1000,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "identity",
    "runtime",
    "runtime_qualification",
    "negotiation",
    "sequence",
    "ttl_ms",
    "qualifications",
    "provisionable_only"
  ],
  "title": "InventoryV2",
  "type": "object",
  "x-max-document-bytes": 65536,
  "x-relational-validation-required": true
}
