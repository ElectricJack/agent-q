          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "amount_microunits": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            "currency": {
              "$ref": "#/$defs/Text",
              "pattern": "^[A-Z]{3}$"
            },
            "kind": {
              "const": "provider_reported",
              "type": "string"
            },
            "receipt": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "amount_microunits",
            "currency",
            "receipt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allocation_policy": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "amount_microunits": {
              "format": "uint64",
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            "basis": {
              "$ref": "#/$defs/EstimateBasis"
            },
            "currency": {
              "$ref": "#/$defs/Text",
              "pattern": "^[A-Z]{3}$"
            },
            "kind": {
              "const": "non_invoice_estimate",
              "type": "string"
            },
            "rate_card": {
              "$ref": "#/$defs/ArtifactRef"
            }
