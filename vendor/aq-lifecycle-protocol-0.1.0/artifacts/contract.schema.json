      "required": [
        "admission_id",
        "continuation",
        "successor",
        "attachment_digest",
        "outcome",
        "acknowledgment_receipt"
      ],
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "id": {
