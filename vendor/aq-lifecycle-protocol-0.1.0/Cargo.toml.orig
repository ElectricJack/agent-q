[package]
name = "aq-lifecycle-protocol"
version = "0.1.0"
edition = "2024"
publish = false
description = "Pure bounded AQ observation, usage and suspended-continuation contracts"
[dependencies]
aq-session-protocol = { path = "../aq-session-protocol", version = "=0.1.0" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
schemars = { version = "1", features = ["uuid1"] }
uuid = { version = "1", features = ["serde"] }
