{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "Digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string",
      "x-utf8-byte-limit": 64
    },
    "InventoryIdentity": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "format": "uuid",
          "type": "string"
        },
        "request_digest": {
          "$ref": "#/$defs/Digest"
        },
        "revision": {
          "format": "uint64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "sequence": {
          "format": "uint64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "operation_id",
        "sequence",
        "revision",
        "request_digest",
        "snapshot_digest"
      ],
      "type": "object"
    },
    "Negotiation": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "qualification": {
          "$ref": "#/$defs/ArtifactRef",
          "properties": {
            "id": {
              "pattern": "^aq[.]scoped-material-presence-qualification/.+"
            }
          }
        }
      },
      "required": [
        "protocol",
        "qualification"
      ],
      "type": "object"
    },
    "Protocol": {
      "enum": [
        "aq.scoped-material-presence.v1"
      ],
      "type": "string"
    },
    "Text": {
      "description": "Nonempty UTF-8 text, at most 512 bytes; no control characters.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string",
      "x-utf8-byte-limit": 512
    },
    "WorkerIdentity": {
      "additionalProperties": false,
      "properties": {
        "boot_id": {
          "format": "uuid",
          "type": "string"
        },
        "node_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "boot_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at_ms": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 1,
      "type": "integer"
    },
    "identity": {
      "$ref": "#/$defs/WorkerIdentity"
    },
    "inventory": {
      "$ref": "#/$defs/InventoryIdentity"
    },
    "negotiation": {
      "$ref": "#/$defs/Negotiation"
    },
    "recorded_at_ms": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "identity",
    "negotiation",
    "inventory",
    "recorded_at_ms",
    "expires_at_ms"
  ],
  "title": "InventoryReceipt",
  "type": "object",
  "x-max-document-bytes": 4096,
  "x-relational-validation-required": true
}
