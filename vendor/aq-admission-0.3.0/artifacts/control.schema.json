            "expires_at_ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expires_at_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "preparing",
