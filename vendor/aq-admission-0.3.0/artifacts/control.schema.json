              "$ref": "#/$defs/Digest"
            },
            "preparation_operation_id": {
              "format": "uuid",
              "maxLength": 4096,
              "type": "string",
              "x-utf8-maxBytes": 4096
            }
          },
          "required": [
            "kind",
            "owner",
            "preparation_operation_id",
            "preparation_digest",
            "expires_at_ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "execution_deadline_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "expires_at_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "grant_id": {
              "format": "uuid",
              "maxLength": 4096,
              "type": "string",
              "x-utf8-maxBytes": 4096
            },
            "kind": {
              "const": "granted",
              "maxLength": 4096,
              "type": "string",
              "x-utf8-maxBytes": 4096
            },
            "owner": {
              "$ref": "#/$defs/LaunchOwner"
            },
            "started_operation_id": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "owner",
            "grant_id",
            "expires_at_ms",
            "execution_deadline_ms"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "execution_deadline_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "kind": {
              "const": "stop_required",
              "maxLength": 4096,
              "type": "string",
              "x-utf8-maxBytes": 4096
