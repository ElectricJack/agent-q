{
  "$comment": "Maximum wire body4MiB. Typed validation additionally checks all nonnil IDs, exact request/nonce/node/boot/binding/owner correlation, immutable nested0.1.6 payload, checked current/hard expiry, revision order and same-revision equality, actual material receipt set, complete explicit reconciliation or bounded owned discovery, and actual encoded byte bounds. aq-delivery-nonce belongs to one physical HTTP send and is outside the immutable mutation digest; current-state observations have no live authority clock. Actual authorization, installed-binding/fingerprint freshness, source/effect/receipt ownership and host state remain daemon/qualified-worker checks. Required nested frozen cardinality and artifact byte bounds are enforced in Rust as documented by the original publications.",
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "source",
        "context",
        "outcome",
        "composition",
        "selection",
        "definition"
      ],
      "maxLength": 4096,
      "type": "string",
      "x-utf8-maxBytes": 4096
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "attempt_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "attempt_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "lineage_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "project_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        },
        "task_id": {
          "format": "uuid",
          "maxLength": 4096,
          "type": "string",
          "x-utf8-maxBytes": 4096
        }
      },
      "required": [
        "project_id",
        "task_id",
        "lineage_id",
        "attempt_id",
        "attempt_generation",
        "session"
      ],
      "type": "object"
    },
    "BudgetBasis": {
      "enum": [
        "task_cumulative_estimated_cost",
        "task_cumulative_enforced_cost"
