    },
    "CurrentPhase": {
      "description": "Read-only current state. In particular Granted has no DeliveryClock and\ncannot be supplied as a launch/renew permit. Actual owners resolve receipts.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expires_at_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
