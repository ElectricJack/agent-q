#!/usr/bin/env bash
# Build and start the development stack (server + PostgreSQL) in Docker Compose.
# Pass --init-only to just create the dev secret.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -f secrets.dev/postgres_password ]; then
  mkdir -p secrets.dev
  chmod 0700 secrets.dev
  # The directory is private to this user; the file itself must be readable by
  # the container user (UID 10001), because Compose bind-mounts it as-is.
  (umask 022; head -c 24 /dev/urandom | base64 | tr -d '\n' >secrets.dev/postgres_password)
  chmod 0644 secrets.dev/postgres_password
  echo "created secrets.dev/postgres_password"
fi
[ "${1:-}" = "--init-only" ] && exit 0

export AQ_SERVER_IMAGE=${AQ_SERVER_IMAGE:-agent-q-server:dev}
export AQ_VAULT_DIR="$PWD/vault.example"
export AQ_SECRETS_DIR="$PWD/secrets.dev"
exec docker compose -f compose.yaml -f compose.dev.yaml up --build "$@"
