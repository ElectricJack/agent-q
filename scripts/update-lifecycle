#!/usr/bin/env bash
# Local end-to-end update lifecycle suite. It drives the host updater
# (aq-updater, built with the test verifier) against real images in a
# throwaway registry, the production compose.yaml and real PostgreSQL:
#
#   1. first install of 0.1.0          5. incompatible release refused
#   2. upgrade to 0.1.1                6. downgrade request through the spool
#   3. broken 0.1.2 rolled back        7. data survives upgrade and rollbacks
#   4. interrupted update recovered
#
# Everything lives under one temporary directory (logs included), the
# Compose project `aq-suite` and the registry container `aq-suite-registry`
# on 127.0.0.1:5000; all of it is removed on exit. On failure the logs are
# first copied to a kept directory whose path is printed. Ends with
# `update-lifecycle: PASS` or names the failed step.
set -euo pipefail
shopt -s inherit_errexit

REPO=$(cd "$(dirname "$0")/.." && pwd)
PROJECT=aq-suite
REGISTRY_NAME=aq-suite-registry
REGISTRY=127.0.0.1:5000
# Short, so the broken release fails over quickly (production uses 120 s).
DEADLINE=45
UPDATER=$REPO/target/debug/aq-updater
# Bounds every `docker compose` call the suite makes (exec included).
DC_TIMEOUT=180
ZERO=$(printf '0%.0s' {1..64})
# What the updater writes into release.env before the first install.
NO_RELEASE_IMAGE=no-release-installed.invalid/agent-q-server@sha256:$ZERO
STEP=start
BG_PID=
IMAGES=()

# Compose must take every variable from the suite's env files: a variable in
# the shell environment would override release.env.
unset AQ_SERVER_IMAGE AQ_VAULT_DIR AQ_SECRETS_DIR AQ_UPDATER_SPOOL \
  COMPOSE_FILE COMPOSE_PROJECT_NAME COMPOSE_PROFILES COMPOSE_ENV_FILES

ROOT=$(mktemp -d "${TMPDIR:-/tmp}/aq-update-lifecycle.XXXXXX")
STATE=$ROOT/state
SPOOL=$STATE/spool
BACKUPS=$ROOT/backups
VAULT=$ROOT/vault
SECRETS=$ROOT/secrets
KEYS=$ROOT/keys
CONFIG=$ROOT/updater.toml
SUITE_ENV=$ROOT/suite.env
LOG_DIR=$ROOT/logs
BUILD_LOG=$LOG_DIR/build.log
UPDATER_LOG=$LOG_DIR/updater.log
COMPOSE_LOG=$LOG_DIR/compose.log
mkdir -p "$LOG_DIR"

# The operator's env file holds only the operator's own paths.
# AQ_SERVER_IMAGE and AQ_UPDATER_SPOOL come from the updater's release.env,
# which it creates at startup (with a placeholder image before the first
# install).
cat >"$SUITE_ENV" <<EOF
AQ_VAULT_DIR=$VAULT
AQ_SECRETS_DIR=$SECRETS
EOF

say() { echo "update-lifecycle: $*"; }
step() {
  STEP=$1
  say "== $1"
}
fail() {
  echo "update-lifecycle: $*" >&2
  exit 1
}

# The suite's view of the updater's Compose project: the same files and env
# files the updater uses.
dc() {
  local args=(--project-name "$PROJECT" --project-directory "$REPO"
    -f "$REPO/compose.yaml" --env-file "$SUITE_ENV")
  if [ -f "$STATE/release.env" ]; then args+=(--env-file "$STATE/release.env"); fi
  timeout -k 10 "$DC_TIMEOUT" docker compose "${args[@]}" "$@"
}
# `timeout` runs its command in a new process group. Run from a terminal,
# anything there that reads the terminal (`compose exec` attaches stdin even
# with -T) is stopped by SIGTTIN and only ends at the timeout. Every call
# below therefore gets stdin from /dev/null, or from a pipe.

# `down` needs only a parseable compose.yaml: before the updater has written
# release.env, its two variables get values that are never used.
dc_down() {
  AQ_SERVER_IMAGE=$NO_RELEASE_IMAGE AQ_UPDATER_SPOOL=$ROOT/no-spool \
    dc down -v --remove-orphans </dev/null
}

updater() {
  timeout -k 30 600 "$UPDATER" --config "$CONFIG" "$@" </dev/null 2>>"$UPDATER_LOG"
}

cleanup() {
  local rc=$?
  set +e
  if [ -n "$BG_PID" ]; then
    kill -9 "$BG_PID" 2>/dev/null
    wait "$BG_PID" 2>/dev/null
  fi
  if [ "$rc" -ne 0 ]; then
    echo "update-lifecycle: FAIL at step: $STEP" >&2
    echo "--- last 40 server log lines ---" >&2
    if [ -f "$STATE/release.env" ]; then
      dc logs --no-color --tail 40 server </dev/null >&2 2>&1
    else
      echo "(no release.env yet: nothing was started)" >&2
    fi
    echo "--- aq-updater status ---" >&2
    if [ -x "$UPDATER" ] && [ -f "$CONFIG" ]; then
      "$UPDATER" --config "$CONFIG" status >&2 2>/dev/null
    fi
    local kept
    if kept=$(mktemp -d "${TMPDIR:-/tmp}/aq-update-lifecycle-logs.XXXXXX") &&
      cp -r "$LOG_DIR/." "$kept/"; then
      echo "--- logs kept in $kept ---" >&2
    fi
  fi
  teardown >/dev/null 2>&1
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

teardown() {
  dc_down
  docker rm -fv "$REGISTRY_NAME"
  if [ "${#IMAGES[@]}" -gt 0 ]; then docker image rm -f "${IMAGES[@]}"; fi
  rm -rf "$ROOT"
}

# poll DESCRIPTION TIMEOUT_SECS INTERVAL_SECS COMMAND...: retry until it
# succeeds or the timeout passes.
poll() {
  local what=$1 timeout=$2 interval=$3
  shift 3
  local deadline=$((SECONDS + timeout))
  until "$@" >/dev/null 2>&1; do
    if ((SECONDS >= deadline)); then
      echo "update-lifecycle: timed out after ${timeout}s waiting for: $what" >&2
      return 1
    fi
    sleep "$interval"
  done
}

# ---------------------------------------------------------------- images

# build TARGET TAG CONTEXT VERSION: a Dockerfile target, stamped for VERSION.
build() {
  docker build --target "$1" -f "$REPO/Dockerfile" \
    --build-arg "AQ_SOURCE_REVISION=suite-$4" --build-arg "AQ_VERSION=$4" \
    -t "$2" "$3" >>"$BUILD_LOG" 2>&1 || {
    tail -30 "$BUILD_LOG" >&2
    fail "docker build --target $1 for $4 failed"
  }
  IMAGES+=("$2")
}

# push TAG: prints the pushed image's digest-pinned reference.
push() {
  docker push "$1" >>"$BUILD_LOG" 2>&1 || fail "docker push $1 failed"
  docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$1" |
    grep -m1 -E "^${1%:*}@sha256:[0-9a-f]{64}$" || fail "no registry digest for $1"
}

# versioned_copy VERSION: a minimal copy of the workspace with the workspace
# version set to VERSION (the version is compiled into the binaries) and the
# lock file entries of the workspace crates updated, so --locked still holds.
versioned_copy() {
  local version=$1 dir=$ROOT/src-$1
  mkdir -p "$dir"
  cp "$REPO/Cargo.toml" "$REPO/Cargo.lock" "$REPO/rust-toolchain.toml" "$dir/"
  cp -r "$REPO/crates" "$dir/"
  sed -i -E '/^\[workspace\.package\]/,/^\[/ s/^version = "[^"]*"/version = "'"$version"'"/' \
    "$dir/Cargo.toml"
  grep -q "^version = \"$version\"$" "$dir/Cargo.toml" || fail "cannot set version $version"
  (cd "$dir" && cargo update --workspace --offline) >>"$BUILD_LOG" 2>&1 ||
    fail "cargo update --workspace failed for $version"
  echo "$dir"
}

# sign_and_publish VERSION DIR: sign DIR/manifest.json with the test key,
# check the signature with the updater itself, and push the release image.
sign_and_publish() {
  local version=$1 dir=$2
  "$UPDATER" test-sign --key "$KEYS/secret.hex" "$dir/manifest.json" \
    >"$dir/manifest.sigstore.json" 2>>"$UPDATER_LOG"
  updater verify-manifest "$dir/manifest.json" "$dir/manifest.sigstore.json" >/dev/null ||
    fail "the $version manifest does not verify"
  build release "$REGISTRY/agent-q-release:$version" "$dir" "$version"
  push "$REGISTRY/agent-q-release:$version" >/dev/null
}

# publish_release VERSION BINARY_IMAGE SERVER_REF WORKER_REF: generate the
# manifest with BINARY_IMAGE's own `aq-server manifest`, then sign and push.
publish_release() {
  local version=$1 binary=$2 server=$3 worker=$4 dir=$ROOT/release-$1
  mkdir -p "$dir"
  timeout -k 10 120 docker run --rm "$binary" manifest --server-image "$server" --worker-image "$worker" \
    --version "$version" --source-revision "suite-$version" \
    </dev/null >"$dir/manifest.json" 2>>"$BUILD_LOG" || fail "aq-server manifest failed for $version"
  sign_and_publish "$version" "$dir"
  say "  release $version: server $server"
}

# release_from CONTEXT VERSION: build, push and publish a working release.
release_from() {
  local ctx=$1 version=$2 server worker
  build server "$REGISTRY/agent-q-server:$version" "$ctx" "$version"
  build worker "$REGISTRY/agent-q-worker:$version" "$ctx" "$version"
  server=$(push "$REGISTRY/agent-q-server:$version")
  worker=$(push "$REGISTRY/agent-q-worker:$version")
  publish_release "$version" "$REGISTRY/agent-q-server:$version" "$server" "$worker"
}

# ------------------------------------------------------------ assertions

readiness_json() { dc exec -T server aq-server readiness </dev/null 2>>"$COMPOSE_LOG"; }

# expect_ready VERSION: the running server is VERSION, built as suite-VERSION,
# with its database reachable and Cloudflare Access configured.
expect_ready() {
  local json
  json=$(readiness_json) || fail "aq-server readiness failed (expected $1)"
  python3 -c '
import json, sys
r, want = json.loads(sys.argv[1]), sys.argv[2]
print("update-lifecycle:   readiness: version %s, source_revision %s, database %s, auth_mode %s"
      % (r["version"], r["source_revision"], r["database"], r["auth_mode"]))
ok = (r["version"] == want and r["source_revision"] == "suite-" + want
      and r["database"] == "ok" and r["auth_mode"] == "cloudflare_access")
sys.exit(0 if ok else 1)' "$json" "$1" || fail "readiness does not report a ready $1"
}

# expect_status STATE ACTIVE PREVIOUS OUTCOME FROM TO DETAIL: check
# `aq-updater status`. STATE is a prefix of the state line; ACTIVE and
# PREVIOUS are versions; the newest history line must be OUTCOME FROM -> TO
# with DETAIL in its text. "*" skips a check.
PY_STATUS='
import re, sys
want = dict(zip(["state", "active", "previous", "outcome", "from", "to", "detail"], sys.argv[1:]))
lines = sys.stdin.read().splitlines()
f = {}
for l in lines:
    m = re.match(r"^(state|active|previous|available):\s+(.*)$", l)
    if m:
        f[m.group(1)] = m.group(2)
errs = []
if want["state"] != "*" and not f.get("state", "").startswith(want["state"]):
    errs.append("state is %r, expected %r" % (f.get("state"), want["state"]))
for k in ("active", "previous"):
    v = want[k]
    if v != "*" and not f.get(k, "").startswith("%s (revision suite-%s," % (v, v)):
        errs.append("%s is %r, expected %s" % (k, f.get(k), v))
newest = ""
if "history (newest first):" in lines:
    i = lines.index("history (newest first):")
    newest = lines[i + 1].strip() if i + 1 < len(lines) else ""
m = re.match(r"^\S+ \S+ (\S+) (\S+) -> (\S+): (.*)$", newest)
if want["outcome"] != "*":
    if not m:
        errs.append("no history entry (newest line %r)" % newest)
    else:
        got = (m.group(1), m.group(2), m.group(3))
        if got != (want["outcome"], want["from"], want["to"]):
            errs.append("newest history is %s %s -> %s, expected %s %s -> %s"
                        % (got + (want["outcome"], want["from"], want["to"])))
        if want["detail"] not in m.group(4):
            errs.append("newest history detail %r lacks %r" % (m.group(4), want["detail"]))
print("update-lifecycle:   status: state %s; active %s" % (f.get("state"), f.get("active", "").split(" ")[0]))
print("update-lifecycle:   status: newest history: %s" % newest)
for e in errs:
    print("update-lifecycle:   status mismatch: " + e, file=sys.stderr)
sys.exit(1 if errs else 0)
'
expect_status() {
  local out
  out=$(updater status) || fail "aq-updater status failed"
  python3 -c "$PY_STATUS" "$@" <<<"$out" || {
    printf '%s\n' "$out" >&2
    fail "aq-updater status is not as expected"
  }
}

psql_suite() {
  dc exec -T postgres psql -U agent_q -d agent_q -v ON_ERROR_STOP=1 -tAc "$1" \
    </dev/null 2>>"$COMPOSE_LOG"
}

add_marker() {
  psql_suite "INSERT INTO suite_marker VALUES ('$1')" >/dev/null ||
    fail "cannot insert marker row $1"
}

# expect_markers ROW...: suite_marker holds exactly these rows (sorted). A
# rollback that restored an older backup would lose the newer rows.
expect_markers() {
  local got
  got=$(psql_suite 'SELECT x FROM suite_marker ORDER BY x' | paste -sd' ') ||
    fail "cannot read the marker rows"
  [ "$got" = "$*" ] || fail "marker rows are '$got', expected '$*'"
  say "  data: marker rows present ($*)"
}

expect_no_maintenance() {
  [ ! -e "$SPOOL/status/maintenance" ] || fail "the maintenance marker is still set"
}

# expect_server_sees VERSION: the server reads status.json through its
# read-only mount and it names VERSION as active.
expect_server_sees() {
  local json
  json=$(dc exec -T server cat /updater/status/status.json </dev/null 2>>"$COMPOSE_LOG") ||
    fail "the server cannot read /updater/status/status.json"
  python3 -c '
import json, sys
s = json.loads(sys.argv[1])
sys.exit(0 if (s.get("active") or {}).get("version") == sys.argv[2] else 1)' "$json" "$1" ||
    fail "the server sees a status.json without $1 active"
  say "  server mount: /updater/status/status.json shows $1 active"
}

# The running server container: id, start time and image.
server_container() {
  local id
  id=$(dc ps -q server </dev/null 2>>"$COMPOSE_LOG")
  [ -n "$id" ] || fail "no server container"
  docker inspect --format '{{.Id}} {{.State.StartedAt}} {{.Config.Image}}' "$id"
}

journal_step() {
  python3 -c '
import json, sys
c = json.load(open(sys.argv[1])).get("current")
print(c["step"] if c else "")' "$STATE/journal.json" 2>/dev/null || true
}

# ------------------------------------------------------------------ setup

step "preflight"
for tool in docker cargo python3 curl timeout; do
  command -v "$tool" >/dev/null || fail "$tool is required"
done
docker compose version >/dev/null || fail "docker compose v2 is required"
dc_down >>"$COMPOSE_LOG" 2>&1 || true
docker rm -fv "$REGISTRY_NAME" >/dev/null 2>&1 || true
say "  work dir $ROOT (logs in $LOG_DIR)"

step "build aq-updater with the test verifier"
cargo build --manifest-path "$REPO/Cargo.toml" -p aq-updater --features test-verifier \
  >>"$BUILD_LOG" 2>&1 || {
  tail -30 "$BUILD_LOG" >&2
  fail "cargo build -p aq-updater failed"
}

step "start the throwaway registry on $REGISTRY"
docker run -d --name "$REGISTRY_NAME" -p "$REGISTRY:5000" registry:2 >>"$COMPOSE_LOG" 2>&1 ||
  fail "cannot start $REGISTRY_NAME (is port 5000 in use?)"
poll "registry API" 60 0.5 curl -fsS --max-time 2 "http://$REGISTRY/v2/"

step "write the production-shaped vault, secrets, signing key and updater config"
mkdir -p "$VAULT" "$SECRETS" "$BACKUPS"
chmod 0755 "$VAULT"
cat >"$VAULT/config.toml" <<'EOF'
format_version = 1
environment = "production"

[server]
admin_bind = "0.0.0.0:8080"
worker_bind = "0.0.0.0:8081"
public_origin = "https://aq.example.com"

[auth]
mode = "cloudflare_access"
team_domain = "https://example.cloudflareaccess.com"
audience = "suite"

[bootstrap]
owner_email = "suite@example.com"
enabled = true

[updates]
spool_dir = "/updater"
EOF
chmod 0644 "$VAULT/config.toml"
# Read by the postgres and server container users through Compose secrets.
(umask 022 && head -c 24 /dev/urandom | base64 | tr -d '\n' >"$SECRETS/postgres_password")
# cloudflared is never started; Compose only needs the file to exist.
echo "suite-dummy-tunnel-token" >"$SECRETS/tunnel_token"
chmod 0644 "$SECRETS/postgres_password" "$SECRETS/tunnel_token"
"$UPDATER" test-keygen "$KEYS" >/dev/null 2>>"$UPDATER_LOG"
cat >"$CONFIG" <<EOF
state_dir = "$STATE"
backup_dir = "$BACKUPS"
release_repo = "$REGISTRY/agent-q-release"
readiness_deadline_secs = $DEADLINE

[compose]
project_dir = "$REPO"
files = ["$REPO/compose.yaml"]
env_files = ["$SUITE_ENV"]
project_name = "$PROJECT"

[verifier]
kind = "test_key"
public_key_hex = "$(tr -d '\n' <"$KEYS/public.hex")"
EOF

step "release 0.1.0 (image A, from the repository)"
release_from "$REPO" 0.1.0

step "release 0.1.1 (image B, from a copy bumped to 0.1.1)"
B_CTX=$(versioned_copy 0.1.1)
release_from "$B_CTX" 0.1.1

step "release 0.1.2 (broken image C, built FROM C0)"
C0_CTX=$(versioned_copy 0.1.2)
build server "$REGISTRY/agent-q-server:0.1.2-c0" "$C0_CTX" 0.1.2
build worker "$REGISTRY/agent-q-worker:0.1.2" "$C0_CTX" 0.1.2
# compose.yaml replaces the image's command, so a broken CMD alone would be
# ignored: C also wraps the binary so that `serve` reads a missing vault.
# The healthcheck, readiness and manifest subcommands pass through.
docker build -t "$REGISTRY/agent-q-server:0.1.2" \
  --build-arg "BASE=$REGISTRY/agent-q-server:0.1.2-c0" - >>"$BUILD_LOG" 2>&1 <<'EOF' ||
ARG BASE
FROM ${BASE}
USER root
RUN mv /usr/local/bin/aq-server /usr/local/bin/aq-server-real \
 && printf '%s\n' '#!/bin/sh' \
      'if [ "$1" = serve ]; then exec /usr/local/bin/aq-server-real serve --vault /missing; fi' \
      'exec /usr/local/bin/aq-server-real "$@"' >/usr/local/bin/aq-server \
 && chmod 0755 /usr/local/bin/aq-server
USER 10001:10001
CMD ["serve", "--vault", "/missing"]
EOF
  fail "cannot build broken image C"
IMAGES+=("$REGISTRY/agent-q-server:0.1.2")
C_SERVER=$(push "$REGISTRY/agent-q-server:0.1.2")
C_WORKER=$(push "$REGISTRY/agent-q-worker:0.1.2")
# C's manifest describes C0's binary, which C runs.
publish_release 0.1.2 "$REGISTRY/agent-q-server:0.1.2-c0" "$C_SERVER" "$C_WORKER"

step "release 0.1.3 (incompatible: state format 2 only, images never pushed)"
mkdir -p "$ROOT/release-0.1.3"
NEVER_SERVER=$REGISTRY/agent-q-server@sha256:$ZERO
NEVER_WORKER=$REGISTRY/agent-q-worker@sha256:$ZERO
# B's manifest with images nobody pushed: an install that pulled before
# checking compatibility would fail the pull (aborted), not be refused.
python3 - "$ROOT/release-0.1.1/manifest.json" "$ROOT/release-0.1.3/manifest.json" \
  "$NEVER_SERVER" "$NEVER_WORKER" <<'PY'
import json, sys
m = json.load(open(sys.argv[1]))
m.update(version="0.1.3", state_format=2, readable_state_formats=[2],
         images={"server": sys.argv[3], "worker": sys.argv[4]})
open(sys.argv[2], "w").write(json.dumps(m, separators=(",", ":"), sort_keys=True))
PY
if timeout -k 10 60 docker pull -q "$NEVER_SERVER" </dev/null >>"$BUILD_LOG" 2>&1; then
  fail "$NEVER_SERVER can be pulled; case 5 would not detect a pull"
fi
sign_and_publish 0.1.3 "$ROOT/release-0.1.3"
say "  release 0.1.3: server $NEVER_SERVER (not in the registry)"

step "bootstrap: the updater's first start on a fresh host"
# Nothing exists yet but the operator's env file. The updater creates its
# state, the spool and a complete release.env, so Compose can start postgres
# before any release is installed.
updater run --once || fail "aq-updater run --once failed on a fresh host"
want_env="AQ_SERVER_IMAGE=$NO_RELEASE_IMAGE
AQ_UPDATER_SPOOL=$SPOOL"
[ "$(cat "$STATE/release.env")" = "$want_env" ] || {
  cat "$STATE/release.env" >&2
  fail "release.env does not hold the placeholder image and the spool"
}
[ -d "$SPOOL/requests" ] && [ -d "$SPOOL/status" ] || fail "the updater did not create the spool"
say "  release.env: AQ_SERVER_IMAGE=$NO_RELEASE_IMAGE"
say "  release.env: AQ_UPDATER_SPOOL=$SPOOL"
# Test-only: in production requests/ belongs to group 10001 (the updater
# runs as root; see the operations docs). Here an ACL lets the server's UID
# write through its mount. The updater's chmod to 2770 keeps it effective.
SPOOL_ACL=0
if command -v setfacl >/dev/null; then
  setfacl -m u:10001:rwx,d:u:10001:rwx "$SPOOL/requests" 2>>"$COMPOSE_LOG" && SPOOL_ACL=1
else
  # No acl tools: the same access and default ACL as setfacl would write
  # (user::rwx, user:10001:rwx, group::rwx, mask::rwx, other::---), set
  # through the POSIX ACL xattrs (format version 2).
  python3 -c '
import os, struct, sys
UNDEF = 0xFFFFFFFF
entries = [(0x01, 7, UNDEF), (0x02, 7, 10001), (0x04, 7, UNDEF), (0x10, 7, UNDEF), (0x20, 0, UNDEF)]
blob = struct.pack("<I", 2) + b"".join(struct.pack("<HHI", *e) for e in entries)
for name in ("system.posix_acl_access", "system.posix_acl_default"):
    os.setxattr(sys.argv[1], name, blob)' "$SPOOL/requests" 2>>"$COMPOSE_LOG" && SPOOL_ACL=1
fi
if [ "$SPOOL_ACL" = 1 ]; then
  say "  requests/: ACL grants UID 10001 rwx"
else
  say "  requests/: no ACL for UID 10001 (setfacl and the ACL xattrs both refused)"
fi

step "start postgres"
dc up -d --wait --wait-timeout 120 postgres </dev/null >>"$COMPOSE_LOG" 2>&1 || {
  tail -20 "$COMPOSE_LOG" >&2
  fail "postgres did not become healthy"
}

# ------------------------------------------------------------------ cases

step "case 1: first install of 0.1.0"
updater install 0.1.0 || fail "install 0.1.0 failed"
expect_status idle 0.1.0 '*' succeeded - 0.1.0 "0.1.0 is active"
expect_ready 0.1.0
expect_no_maintenance
expect_server_sees 0.1.0
say "PASS case 1: first install"

step "case 7 (setup): insert a marker row under 0.1.0"
psql_suite "CREATE TABLE suite_marker(x text)" >/dev/null || fail "cannot create suite_marker"
add_marker under-0.1.0
expect_markers under-0.1.0

step "case 2: upgrade 0.1.0 -> 0.1.1"
updater install 0.1.1 || fail "install 0.1.1 failed"
expect_status idle 0.1.1 0.1.0 succeeded 0.1.0 0.1.1 "0.1.1 is active"
expect_ready 0.1.1
expect_no_maintenance
expect_markers under-0.1.0
say "PASS case 2: upgrade"

step "case 7 (setup): insert a second marker row under 0.1.1"
add_marker under-0.1.1
expect_markers under-0.1.0 under-0.1.1

step "case 3: broken 0.1.2 rolls back to 0.1.1"
started=$SECONDS
rc=0
updater install 0.1.2 || rc=$?
elapsed=$((SECONDS - started))
[ "$rc" -eq 1 ] || fail "install 0.1.2 exited $rc, expected 1 (rolled back)"
# One failed probe of C, then one probe of B; each bounded by the deadline.
((elapsed <= 2 * DEADLINE + 60)) || fail "the rollback took ${elapsed}s"
say "  install 0.1.2 finished in ${elapsed}s (readiness deadline ${DEADLINE}s)"
expect_status idle 0.1.1 0.1.0 rolled_back 0.1.1 0.1.2 "not healthy within $DEADLINE s"
expect_ready 0.1.1
expect_no_maintenance
expect_markers under-0.1.0 under-0.1.1
say "PASS case 3: broken release rolled back"

step "case 4: update interrupted by kill -9 while probing, then recovered"
"$UPDATER" --config "$CONFIG" install 0.1.2 </dev/null >>"$UPDATER_LOG" 2>&1 &
BG_PID=$!
deadline=$((SECONDS + 180))
until [ "$(journal_step)" = probing ]; do
  kill -0 "$BG_PID" 2>/dev/null || fail "the updater exited before reaching the probing step"
  ((SECONDS < deadline)) || fail "timed out waiting for the journal to reach probing"
  sleep 0.2
done
kill -9 "$BG_PID"
rc=0
wait "$BG_PID" || rc=$?
BG_PID=
[ "$rc" -eq 137 ] || fail "the updater exited $rc instead of being killed"
say "  updater killed at step $(journal_step)"
expect_status "in_progress: 0.1.2 at step probing" 0.1.1 0.1.0 '*' '*' '*' '*'
[ -e "$SPOOL/status/maintenance" ] || fail "maintenance is not on after the kill"
updater run --once || fail "run --once failed"
expect_status idle 0.1.1 0.1.0 rolled_back 0.1.1 0.1.2 "interrupted at step probing"
expect_ready 0.1.1
expect_no_maintenance
expect_server_sees 0.1.1
expect_markers under-0.1.0 under-0.1.1
say "PASS case 4: interrupted update recovered"

step "case 5: incompatible 0.1.3 is refused and 0.1.1 keeps running"
before=$(server_container)
rc=0
updater install 0.1.3 || rc=$?
[ "$rc" -eq 1 ] || fail "install 0.1.3 exited $rc, expected 1 (refused)"
expect_status idle 0.1.1 0.1.0 refused 0.1.1 0.1.3 "installed data uses state format 1"
after=$(server_container)
[ "$before" = "$after" ] || fail "the server container changed: $before -> $after"
say "  server container untouched: ${after:0:12}"
expect_ready 0.1.1
expect_no_maintenance
say "PASS case 5: incompatible release refused"

step "case 6: downgrade request through the spool is refused"
REQ_ID=$(python3 -c 'import uuid; print(uuid.uuid4())')
REQ_JSON=$(python3 -c '
import json, sys
from datetime import datetime, timezone
print(json.dumps({"id": sys.argv[1], "version": "0.1.0", "requested_by": "suite@example.com",
                  "requested_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")}))' "$REQ_ID")
# The server's write: a dotfile (ignored by the updater), then a rename.
# Done inside the server container, as UID 10001, through its mount. With
# the ACL in place a failure is a broken mount and fails the suite; only
# without one (no way to grant UID 10001 access here) is it written from
# the host instead.
if [ "$SPOOL_ACL" = 1 ]; then
  printf '%s\n' "$REQ_JSON" | dc exec -T server sh -ec \
    'cat >"/updater/requests/.tmp-$1" && mv "/updater/requests/.tmp-$1" "/updater/requests/$1.json"' \
    sh "$REQ_ID" 2>>"$COMPOSE_LOG" ||
    fail "the server container cannot write the request through /updater/requests"
  owner=$(stat -c %u "$SPOOL/requests/$REQ_ID.json")
  [ "$owner" = 10001 ] || fail "the request file is owned by UID $owner, not the server's 10001"
  say "  request $REQ_ID written by the server container (UID 10001) via /updater/requests"
else
  REQ_TMP=$SPOOL/requests/.tmp-$REQ_ID
  printf '%s\n' "$REQ_JSON" >"$REQ_TMP"
  chmod 0640 "$REQ_TMP"
  mv "$REQ_TMP" "$SPOOL/requests/$REQ_ID.json"
  say "NOTE: server-side spool write not exercised locally (VPS run covers it); request written from the host"
fi
updater run --once || fail "run --once failed"
expect_status idle 0.1.1 0.1.0 refused 0.1.1 0.1.0 "older than installed 0.1.1"
python3 - "$SPOOL/status/status.json" "$REQ_ID" <<'PY' || fail "status.json does not record the refusal"
import json, sys
s = json.load(open(sys.argv[1]))
e = s["history"][0]
assert e["request_id"] == sys.argv[2], e
assert e["outcome"] == "refused" and e["to"] == "0.1.0" and "older" in e["detail"], e
assert s["state"] == {"kind": "idle"}, s["state"]
print("update-lifecycle:   status.json: request %s refused" % e["request_id"])
PY
[ ! -e "$SPOOL/requests/$REQ_ID.json" ] || fail "requests/$REQ_ID.json is still there"
# Nothing else either, dotfiles included.
left=$(find "$SPOOL/requests" -mindepth 1 -print)
[ -z "$left" ] || fail "requests/ still holds: $left"
say "  requests/ is empty"
expect_ready 0.1.1
say "PASS case 6: downgrade request refused"

step "case 7: data survived the upgrade and both rollbacks"
expect_markers under-0.1.0 under-0.1.1
say "PASS case 7: data survives"

step "tear down"
trap - EXIT
teardown >>"$COMPOSE_LOG" 2>&1 || true
[ -z "$(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT")" ] ||
  fail "suite containers left behind"
[ -z "$(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT")" ] ||
  fail "suite volumes left behind"
[ -z "$(docker ps -aq --filter "name=^${REGISTRY_NAME}\$")" ] || fail "registry left behind"
[ ! -e "$ROOT" ] || fail "$ROOT left behind"
echo "update-lifecycle: PASS"
