{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable global supervisor conversation foundation v1",
  "$defs": {
    "Create": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_conversation_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "x-utf8-maxBytes": 16384
        },
        "context": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/ContextRef"
          }
        },
        "attachments": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/AttachmentRef"
          },
          "description": "Staged uploads pinned by id and content digest; ids are unique within a message."
        }
      },
      "required": [
        "operation_id",
        "message_id",
        "expected_conversation_revision",
        "body",
        "context",
        "attachments"
      ],
      "additionalProperties": false,
      "description": "operation_id and message_id must be nonnil and must differ; body must be nonblank and cannot contain NUL."
    },
    "Discovery": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "human-supervisor-conversation-1"
        },
        "conversation": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "label": {
              "const": "Global supervisor"
            }
          },
          "required": [
            "id",
            "revision",
            "label"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "limits": {
          "type": "object",
          "properties": {
            "body_bytes": {
              "const": 16384
            },
            "context_refs": {
              "const": 16
            },
            "attachments": {
              "const": 4
            },
            "history_page": {
              "const": 16
            }
          },
          "required": [
            "body_bytes",
            "context_refs",
            "attachments",
            "history_page"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "conversation",
        "runtime",
        "limits"
      ],
      "additionalProperties": false
    },
    "History": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "human-supervisor-conversation-1"
        },
        "conversation": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "label": {
              "const": "Global supervisor"
            }
          },
          "required": [
            "id",
            "revision",
            "label"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "direction": {
          "enum": [
            "forward",
            "backward"
          ]
        },
        "through_cursor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "items": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/HumanItem"
              },
              {
                "$ref": "#/$defs/SupervisorItem"
              }
            ]
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}(\\.[1-9][0-9]{0,18})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "conversation",
        "runtime",
        "direction",
        "through_cursor",
        "items",
        "next_cursor",
        "has_more"
      ],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "human-supervisor-conversation-1"
        },
        "conversation": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "label": {
              "const": "Global supervisor"
            }
          },
          "required": [
            "id",
            "revision",
            "label"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "binding": {
              "type": "null"
            },
            "reason": {
              "const": "central_runtime_not_connected"
            }
          },
          "required": [
            "state",
            "binding",
            "reason"
          ],
          "additionalProperties": false
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "body_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "queued",
            "not_queued"
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "conversation_revision_changed",
                "message_id_conflict",
                "attachment_unavailable"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "host_delivery": {
          "const": "not_attempted"
        },
        "agent_receipt": {
          "type": "null"
        }
      },
      "required": [
        "contract",
        "conversation",
        "runtime",
        "operation_id",
        "message_id",
        "actor_id",
        "request_digest",
        "body_digest",
        "state",
        "cursor",
        "reason",
        "host_delivery",
        "agent_receipt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "queued"
              }
            }
          },
          "then": {
            "properties": {
              "cursor": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "cursor": {
                "type": "null"
              },
              "reason": {
                "enum": [
                  "conversation_revision_changed",
                  "message_id_conflict",
                  "attachment_unavailable"
                ]
              }
            }
          }
        }
      ]
    },
    "HumanItem": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "cursor": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "author": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "human"
            },
            "user_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "user_id"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "x-utf8-maxBytes": 16384
        },
        "body_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "logical_admission": {
          "const": "queued"
        },
        "host_delivery": {
          "enum": [
            "not_attempted",
            "pending",
            "delivery_unknown",
            "delivered",
            "not_delivered"
          ]
        },
        "agent_receipt": {
          "type": "null"
        },
        "context": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/ContextRef"
          },
          "description": "Omitted when the message has no context refs."
        },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/AttachmentDescriptor"
          },
          "description": "Owner files bound to this message, in Create order. Omitted when the message has none."
        }
      },
      "required": [
        "message_id",
        "thread_id",
        "conversation_id",
        "cursor",
        "author",
        "body",
        "body_digest",
        "created_at_ms",
        "logical_admission",
        "host_delivery",
        "agent_receipt"
      ],
      "additionalProperties": false
    },
    "SupervisorItem": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "cursor": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}\\.[1-9][0-9]{0,18}$"
        },
        "author": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "supervisor"
            },
            "actor_id": {
              "type": "string",
              "format": "uuid"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "actor_id",
            "generation",
            "session_id"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "x-utf8-maxBytes": 16384
        },
        "body_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "logical_admission": {
          "const": "queued"
        },
        "host_delivery": {
          "const": "not_attempted"
        },
        "agent_receipt": {
          "type": "null"
        },
        "dispatch": {
          "type": "object",
          "properties": {
            "dispatch_id": {
              "type": "string",
              "format": "uuid"
            },
            "host_operation_id": {
              "type": "string",
              "format": "uuid"
            },
            "batch_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "dispatch_id",
            "host_operation_id",
            "batch_digest"
          ],
          "additionalProperties": false
        },
        "attachments": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/SupervisorAttachment"
          },
          "description": "Additive in v1: always present (possibly empty) on current servers; absent on older ones."
        }
      },
      "required": [
        "message_id",
        "thread_id",
        "conversation_id",
        "cursor",
        "author",
        "body",
        "body_digest",
        "dispatch",
        "created_at_ms",
        "logical_admission",
        "host_delivery",
        "agent_receipt"
      ],
      "additionalProperties": false
    },
    "DraftTask": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "body": {
          "type": "string",
          "maxLength": 32768
        },
        "acceptance_criteria": {
          "type": "string",
          "maxLength": 8192
        },
        "labels": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "task_state": {
          "enum": [
            "draft",
            "active"
          ]
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_hint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "intelligence_hint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "task_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "description": "Same task fields as dashboard-actions-1 task.graph.create."
    },
    "DraftDependency": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "string",
          "format": "uuid"
        },
        "target": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "TaskGraphCreate": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DraftTask"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 99,
          "items": {
            "$ref": "#/$defs/DraftDependency"
          }
        }
      },
      "required": [
        "operation_id",
        "project_id",
        "expected_version",
        "tasks"
      ],
      "additionalProperties": false,
      "description": "The exact dashboard-actions-1 task.graph.create payload the Owner may submit after review. Server checks the same relational rules (unique nonnil IDs, at most 100 total mutations)."
    },
    "ProposedTaskDraft": {
      "type": "object",
      "properties": {
        "type": {
          "const": "proposed_task_draft"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "draft_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "payload": {
          "$ref": "#/$defs/TaskGraphCreate"
        }
      },
      "required": [
        "type",
        "message_id",
        "draft_id",
        "project_id",
        "revision",
        "payload_digest",
        "payload"
      ],
      "additionalProperties": false,
      "description": "A proposal only; nothing was created. project_id and revision equal payload.project_id and payload.expected_version. payload_digest is sha256 over the canonical (sorted-key, compact) JSON of payload. message_id is the supervisor reply that produced it."
    },
    "ActionReceipt": {
      "type": "object",
      "properties": {
        "type": {
          "const": "action_receipt"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "task.create",
            "task.graph.create"
          ]
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_task_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "created_edge_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "receipt_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "type",
        "message_id",
        "operation_id",
        "kind",
        "project_id",
        "project_revision",
        "created_task_ids",
        "created_edge_ids",
        "receipt_refs",
        "request_digest"
      ],
      "additionalProperties": false,
      "description": "Snapshot, taken when the reply was written, of a confirmed operation in the replying supervisor session's own journal. Retained with the reply; Owners need no supervisor operation lookup."
    },
    "SupervisorAttachment": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposedTaskDraft"
        },
        {
          "$ref": "#/$defs/ActionReceipt"
        }
      ]
    },
    "ReplyAttachmentRequest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "proposed_task_draft"
            },
            "draft_id": {
              "type": "string",
              "format": "uuid"
            },
            "payload": {
              "$ref": "#/$defs/TaskGraphCreate"
            }
          },
          "required": [
            "type",
            "draft_id",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "action_receipt"
            },
            "operation_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "type",
            "operation_id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Entry of the optional attachments array (at most 4, at most 65536 serialized bytes, unique nonnil draft/operation IDs) on POST /v1/supervisor/conversation/replies. The server derives every other History field."
    },
    "Runtime": {
      "description": "X4: unavailable until an active central session serves this conversation; then bound to that session. Receipts keep the admission-time unavailable runtime.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "binding": {
              "type": "null"
            },
            "reason": {
              "const": "central_runtime_not_connected"
            }
          },
          "required": [
            "state",
            "binding",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "available"
            },
            "binding": {
              "type": "object",
              "properties": {
                "actor_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "generation": {
                  "type": "integer",
                  "minimum": 1
                },
                "session_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "actor_id",
                "generation",
                "session_id"
              ],
              "additionalProperties": false
            },
            "reason": {
              "const": "central_session_active"
            }
          },
          "required": [
            "state",
            "binding",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ContextRef": {
      "type": "object",
      "description": "X5: a pinned reference to an AQ entity. Unique by (type, id) within a message; the server checks shape only.",
      "properties": {
        "type": {
          "enum": [
            "project",
            "task",
            "result",
            "review",
            "knowledge",
            "session",
            "playbook_run"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "ReadMarker": {
      "type": "object",
      "description": "X6: the caller's monotonic read cursor. unread counts items after read_cursor not authored by the caller, capped at 100.",
      "properties": {
        "contract": {
          "const": "human-supervisor-conversation-1"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "principal_id": {
          "type": "string",
          "format": "uuid"
        },
        "read_cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}(\\.[1-9][0-9]{0,18})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}(\\.[1-9][0-9]{0,18})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unread": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "capped": {
              "type": "boolean"
            }
          },
          "required": [
            "count",
            "capped"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "conversation_id",
        "principal_id",
        "read_cursor",
        "latest_cursor",
        "unread"
      ],
      "additionalProperties": false
    },
    "ReadMarkerUpdate": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}(\\.[1-9][0-9]{0,18})?$"
        }
      },
      "required": [
        "cursor"
      ],
      "additionalProperties": false,
      "description": "Moves the marker forward to cursor; an earlier cursor is a no-op and a cursor past latest_cursor is refused."
    },
    "AttachmentRef": {
      "type": "object",
      "description": "A reference from Create.attachments to a staged upload of the same owner and conversation.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "additionalProperties": false
    },
    "AttachmentDescriptor": {
      "type": "object",
      "description": "Metadata of one stored owner file. digest is sha256 over the exact stored bytes.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "x-utf8-maxBytes": 255,
          "description": "One path segment: no control characters, slashes, backslashes, or leading/trailing whitespace; not . or .."
        },
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown",
            "text/csv",
            "application/json",
            "application/pdf",
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "size_bytes",
        "digest"
      ],
      "additionalProperties": false
    },
    "AttachmentUpload": {
      "type": "object",
      "description": "Response to PUT .../attachments/{id}. A staged upload expires at expires_at_ms unless a Create binds it; an attached one lives as long as its message.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "x-utf8-maxBytes": 255,
          "description": "One path segment: no control characters, slashes, backslashes, or leading/trailing whitespace; not . or .."
        },
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown",
            "text/csv",
            "application/json",
            "application/pdf",
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "staged",
            "attached"
          ]
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "size_bytes",
        "digest",
        "conversation_id",
        "created_at_ms",
        "state",
        "message_id",
        "expires_at_ms"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "staged"
              }
            }
          },
          "then": {
            "properties": {
              "message_id": {
                "type": "null"
              },
              "expires_at_ms": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "else": {
            "properties": {
              "message_id": {
                "type": "string",
                "format": "uuid"
              },
              "expires_at_ms": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Discovery"
    },
    {
      "$ref": "#/$defs/History"
    },
    {
      "$ref": "#/$defs/Receipt"
    },
    {
      "$ref": "#/$defs/ReadMarker"
    },
    {
      "$ref": "#/$defs/AttachmentUpload"
    }
  ]
}
