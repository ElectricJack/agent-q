{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable global supervisor conversation foundation v1",
  "$defs": {
    "Create": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_conversation_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "x-utf8-maxBytes": 16384
        },
        "context": {
          "type": "array",
          "maxItems": 0
        },
        "attachments": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "operation_id",
        "message_id",
        "expected_conversation_revision",
        "body",
        "context",
        "attachments"
      ],
      "additionalProperties": false
    },
    "Discovery": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "human-supervisor-conversation-1"
        },
        "conversation": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "label": {
              "const": "Global supervisor"
            }
          },
          "required": [
            "id",
            "revision",
            "label"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "binding": {
              "type": "null"
            },
            "reason": {
              "const": "central_runtime_not_connected"
            }
          },
          "required": [
            "state",
            "binding",
            "reason"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "body_bytes": {
              "const": 16384
            },
            "context_refs": {
              "const": 0
            },
            "attachments": {
              "const": 0
            },
            "history_page": {
              "const": 16
            }
          },
          "required": [
            "body_bytes",
            "context_refs",
            "attachments",
            "history_page"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "conversation",
        "runtime",
        "limits"
      ],
      "additionalProperties": false
    },
    "History": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "human-supervisor-conversation-1"
        },
        "conversation": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "label": {
              "const": "Global supervisor"
            }
          },
          "required": [
            "id",
            "revision",
            "label"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "binding": {
              "type": "null"
            },
            "reason": {
              "const": "central_runtime_not_connected"
            }
          },
          "required": [
            "state",
            "binding",
            "reason"
          ],
          "additionalProperties": false
        },
        "direction": {
          "enum": [
            "forward",
            "backward"
          ]
        },
        "through_cursor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "items": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "message_id": {
                "type": "string",
                "format": "uuid"
              },
              "thread_id": {
                "type": "string",
                "format": "uuid"
              },
              "conversation_id": {
                "type": "string",
                "format": "uuid"
              },
              "cursor": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "author": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "human"
                  },
                  "user_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "kind",
                  "user_id"
                ],
                "additionalProperties": false
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "x-utf8-maxBytes": 16384
              },
              "body_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "created_at_ms": {
                "type": "integer",
                "minimum": 1
              },
              "logical_admission": {
                "const": "queued"
              },
              "host_delivery": {
                "const": "not_attempted"
              },
              "agent_receipt": {
                "type": "null"
              }
            },
            "required": [
              "message_id",
              "thread_id",
              "conversation_id",
              "cursor",
              "author",
              "body",
              "body_digest",
              "created_at_ms",
              "logical_admission",
              "host_delivery",
              "agent_receipt"
            ],
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "contract",
        "conversation",
        "runtime",
        "direction",
        "through_cursor",
        "items",
        "next_cursor",
        "has_more"
      ],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "human-supervisor-conversation-1"
        },
        "conversation": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "label": {
              "const": "Global supervisor"
            }
          },
          "required": [
            "id",
            "revision",
            "label"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "binding": {
              "type": "null"
            },
            "reason": {
              "const": "central_runtime_not_connected"
            }
          },
          "required": [
            "state",
            "binding",
            "reason"
          ],
          "additionalProperties": false
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "body_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "queued",
            "not_queued"
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "conversation_revision_changed",
                "message_id_conflict"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "host_delivery": {
          "const": "not_attempted"
        },
        "agent_receipt": {
          "type": "null"
        }
      },
      "required": [
        "contract",
        "conversation",
        "runtime",
        "operation_id",
        "message_id",
        "actor_id",
        "request_digest",
        "body_digest",
        "state",
        "cursor",
        "reason",
        "host_delivery",
        "agent_receipt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "queued"
              }
            }
          },
          "then": {
            "properties": {
              "cursor": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "cursor": {
                "type": "null"
              },
              "reason": {
                "enum": [
                  "conversation_revision_changed",
                  "message_id_conflict"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Discovery"
    },
    {
      "$ref": "#/$defs/History"
    },
    {
      "$ref": "#/$defs/Receipt"
    }
  ]
}
