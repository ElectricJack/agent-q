          },
          "maxItems": 100,
          "type": "array"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "operation_id": {
          "format": "uuid",
          "type": "string"
        },
        "receipt_refs": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "maxItems": 100,
          "type": "array"
        },
        "recovery": {
          "$ref": "#/$defs/Recovery"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "subject_refs": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "maxItems": 1,
          "type": "array"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "operation_id",
        "disposition",
        "request_digest",
        "scope",
        "created_at",
        "updated_at",
        "subject_refs",
        "receipt_refs",
        "affected_entities",
        "recovery"
      ],
      "type": "object"
    },
    "Quality": {
      "enum": [
        "reported",
        "unknown"
      ],
      "type": "string"
    },
    "Recovery": {
      "enum": [
        "lookup_original",
        "refresh_and_review",
        "none"
      ],
      "type": "string"
    },
    "Scope": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "all_authorized",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "project",
              "type": "string"
            },
            "project_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "project_id"
          ],
          "type": "object"
        }
      ]
    },
    "Timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ActionRequest"
    },
    {
      "$ref": "#/$defs/Envelope"
    },
    {
      "$ref": "#/$defs/ErrorEnvelope"
    }
  ],
  "title": "Wire",
  "x-capability-version": 1
}
