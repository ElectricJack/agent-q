{
  "$defs": {
    "ActionRequest": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "decision.resolve"
            },
            "payload": {
              "$defs": {
                "ArtifactRef": {
                  "additionalProperties": false,
                  "properties": {
                    "digest": {
                      "$ref": "#/$defs/Digest"
                    },
                    "id": {
                      "$ref": "#/$defs/Text"
                    },
                    "version": {
                      "$ref": "#/$defs/Text"
                    }
                  },
                  "required": [
                    "id",
                    "version",
                    "digest"
                  ],
                  "type": "object"
                },
                "Choice": {
                  "enum": [
                    "approve",
                    "reject"
                  ],
                  "type": "string"
                },
                "Digest": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "Text": {
                  "description": "Nonempty UTF-8 text, at most 512 bytes; no control characters.",
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "$id": "urn:aq:dashboard-actions:1:decision.resolve:payload",
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "properties": {
                "choice": {
                  "$ref": "#/$defs/Choice"
                },
                "comment": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "decision_id": {
                  "format": "uuid",
                  "type": "string"
                },
                "expected_decision_revision": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "expected_subject": {
                  "$ref": "#/$defs/ArtifactRef"
                },
                "operation_id": {
                  "format": "uuid",
                  "type": "string"
                },
                "schema_version": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "schema_version",
                "operation_id",
                "decision_id",
                "expected_decision_revision",
                "choice",
                "expected_subject"
              ],
              "title": "Resolve",
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "supervisor.message.send"
            },
            "payload": {
              "$id": "urn:aq:dashboard-actions:1:supervisor.message.send:payload",
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "properties": {
                "attachments": {
                  "items": true,
                  "maxItems": 0,
                  "type": "array"
                },
                "body": {
                  "maxLength": 16384,
                  "minLength": 1,
                  "type": "string"
                },
                "context": {
                  "items": true,
                  "maxItems": 0,
                  "type": "array"
                },
                "expected_conversation_revision": {
                  "pattern": "^[1-9][0-9]{0,18}$",
                  "type": "string"
                },
                "message_id": {
                  "format": "uuid",
                  "type": "string"
                },
                "operation_id": {
                  "format": "uuid",
                  "type": "string"
                }
              },
              "required": [
                "operation_id",
                "message_id",
                "expected_conversation_revision",
                "body",
                "context",
                "attachments"
              ],
              "title": "Create",
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "task.create"
            },
            "payload": {
              "$defs": {
                "TaskState": {
                  "enum": [
                    "draft",
                    "active"
                  ],
                  "type": "string"
                }
              },
              "$id": "urn:aq:dashboard-actions:1:task.create:payload",
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "additionalProperties": false,
              "properties": {
                "acceptance_criteria": {
                  "maxLength": 8192,
                  "type": "string"
                },
                "body": {
                  "maxLength": 32768,
                  "type": "string"
                },
                "expected_project_revision": {
                  "pattern": "^[1-9][0-9]{0,18}$",
                  "type": "string"
                },
                "labels": {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 16,
                  "type": "array"
                },
                "operation_id": {
                  "format": "uuid",
                  "type": "string"
                },
                "task_state": {
                  "$ref": "#/$defs/TaskState"
                },
                "title": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "operation_id",
                "expected_project_revision",
                "title",
                "body",
                "acceptance_criteria",
                "labels",
                "task_state"
              ],
              "title": "Create",
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ]
        }
      ],
      "properties": {
        "expected_versions": {
          "additionalProperties": {
            "pattern": "^[1-9][0-9]{0,39}$",
            "type": "string"
          },
          "maxProperties": 32,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "type": "object"
        },
        "kind": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "type": "string"
        },
        "payload": true,
        "reason": {
          "maxLength": 1024,
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "$ref": "#/$defs/EntityRef"
        }
      },
      "required": [
        "operation_id",
        "kind",
        "subject",
        "expected_versions",
        "payload"
      ],
      "type": "object"
    },
    "ActionVersion": {
      "enum": [
        "dashboard-actions-1"
      ],
      "type": "string"
    },
    "Completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/Completeness"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "Disposition": {
      "enum": [
        "pending",
        "confirmed",
        "conflict",
        "rejected",
        "unknown"
      ],
      "type": "string"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "pattern": "^[1-9][0-9]{0,39}$",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ActionVersion"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "data": {
          "$ref": "#/$defs/Operation"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "pending_operations": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "request_id": {
          "format": "uuid",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "server_time": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "api_version",
        "request_id",
        "server_time",
        "scope",
        "data",
        "observation",
        "pending_operations",
        "coverage"
      ],
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "type": "string"
        },
        "current_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "field_errors": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "message": {
          "maxLength": 256,
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "format": "uuid",
          "type": "string"
        },
        "retry_after_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "request_id",
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/Completeness"
        },
        "fresh_until": {
          "$ref": "#/$defs/Timestamp"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "observed_at",
        "fresh_until",
        "source",
        "quality",
        "coverage"
      ],
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "affected_entities": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "maxItems": 100,
          "type": "array"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "operation_id": {
          "format": "uuid",
          "type": "string"
        },
        "receipt_refs": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "maxItems": 100,
          "type": "array"
        },
        "recovery": {
          "$ref": "#/$defs/Recovery"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "subject_refs": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "maxItems": 1,
          "type": "array"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "operation_id",
        "disposition",
        "request_digest",
        "scope",
        "created_at",
        "updated_at",
        "subject_refs",
        "receipt_refs",
        "affected_entities",
        "recovery"
      ],
      "type": "object"
    },
    "Quality": {
      "enum": [
        "reported",
        "unknown"
      ],
      "type": "string"
    },
    "Recovery": {
      "enum": [
        "lookup_original",
        "refresh_and_review",
        "none"
      ],
      "type": "string"
    },
    "Scope": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "all_authorized",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "project",
              "type": "string"
            },
            "project_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "project_id"
          ],
          "type": "object"
        }
      ]
    },
    "Timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ActionRequest"
    },
    {
      "$ref": "#/$defs/Envelope"
    },
    {
      "$ref": "#/$defs/ErrorEnvelope"
    }
  ],
  "title": "Wire",
  "x-capability-version": 1
}
