{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract",
  "type": "object",
  "properties": {
    "admissions": {
      "$ref": "#/$defs/Page4"
    },
    "detail": {
      "$ref": "#/$defs/RunDetail"
    },
    "query": {
      "$ref": "#/$defs/PageQuery"
    },
    "runs": {
      "$ref": "#/$defs/Page"
    },
    "runs_query": {
      "$ref": "#/$defs/RunsQuery"
    }
  },
  "required": [
    "query",
    "runs_query",
    "runs",
    "detail",
    "admissions"
  ],
  "$defs": {
    "ActiveDefinitionView": {
      "type": "object",
      "properties": {
        "activation_revision": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "binding": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "binding",
        "artifact",
        "version",
        "activation_revision"
      ]
    },
    "AdmissionView": {
      "type": "object",
      "properties": {
        "activation_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalog_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "status",
        "created_at_ms"
      ]
    },
    "DefinitionView": {
      "description": "X30/X31. `version` is AQ's per-name install ordinal (\"1\", \"2\", ...): the\nengine has no definition version.",
      "type": "object",
      "properties": {
        "active": {
          "description": "The activation new runs of this definition use: the pinned one when it\nis still active, otherwise the highest registered version.",
          "anyOf": [
            {
              "$ref": "#/$defs/ActiveDefinitionView"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "pinned_is_active": {
          "description": "Whether a current activation of this definition name still selects the\nrun's pinned artifact. Null when the current catalog could not be read\nin this observation (never guessed).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Edge": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "to"
      ]
    },
    "EffectView": {
      "type": "object",
      "properties": {
        "cancel_requested": {
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "deadline_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "step",
        "command",
        "status",
        "cancel_requested"
      ]
    },
    "NamespaceView": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "generation",
        "name",
        "project_id"
      ]
    },
    "Page": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunView"
          }
        },
        "namespace": {
          "$ref": "#/$defs/NamespaceView"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "Each page is a fresh bounded observation; not a cross-owner snapshot.",
          "type": [
            "string",
            "null"
          ]
        },
        "server_time_ms": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "api_version",
        "namespace",
        "server_time_ms",
        "items"
      ]
    },
    "Page2": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectView"
          }
        },
        "namespace": {
          "$ref": "#/$defs/NamespaceView"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "Each page is a fresh bounded observation; not a cross-owner snapshot.",
          "type": [
            "string",
            "null"
          ]
        },
        "server_time_ms": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "api_version",
        "namespace",
        "server_time_ms",
        "items"
      ]
    },
    "Page3": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReceiptView"
          }
        },
        "namespace": {
          "$ref": "#/$defs/NamespaceView"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "Each page is a fresh bounded observation; not a cross-owner snapshot.",
          "type": [
            "string",
            "null"
          ]
        },
        "server_time_ms": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "api_version",
        "namespace",
        "server_time_ms",
        "items"
      ]
    },
    "Page4": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AdmissionView"
          }
        },
        "namespace": {
          "$ref": "#/$defs/NamespaceView"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "description": "Each page is a fresh bounded observation; not a cross-owner snapshot.",
          "type": [
            "string",
            "null"
          ]
        },
        "server_time_ms": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "api_version",
        "namespace",
        "server_time_ms",
        "items"
      ]
    },
    "PageQuery": {
      "type": "object",
      "properties": {
        "after": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "maximum": 25,
          "minimum": 1
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "ReceiptView": {
      "type": "object",
      "properties": {
        "at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "child": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": "string"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "step",
        "at_ms",
        "kind"
      ]
    },
    "RunDetail": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "string"
        },
        "effects": {
          "$ref": "#/$defs/Page2"
        },
        "namespace": {
          "$ref": "#/$defs/NamespaceView"
        },
        "observation_is_atomic": {
          "type": "boolean"
        },
        "receipts": {
          "$ref": "#/$defs/Page3"
        },
        "run": {
          "$ref": "#/$defs/RunView"
        },
        "server_time_ms": {
          "type": "integer",
          "format": "int64"
        },
        "steps": {
          "description": "X32: ordered step graph of the run's pinned definition from its entry;\nnull when no public graph is registered for the artifact.",
          "anyOf": [
            {
              "$ref": "#/$defs/StepTimeline"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "api_version",
        "namespace",
        "server_time_ms",
        "run",
        "effects",
        "receipts",
        "observation_is_atomic"
      ]
    },
    "RunView": {
      "type": "object",
      "properties": {
        "activation_revision": {
          "description": "Activation revision the run was admitted at; null when not known.",
          "type": [
            "string",
            "null"
          ]
        },
        "admitted_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "artifact": {
          "type": "string"
        },
        "binding": {
          "description": "Binding the run was admitted on; null for runs not started through a\nretained admission (children, event starts) or admitted before it was kept.",
          "type": [
            "string",
            "null"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definition": {
          "description": "X30/X31: null when the artifact has no AQ registry entry.",
          "anyOf": [
            {
              "$ref": "#/$defs/DefinitionView"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "entry": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "waiting": {
          "description": "X33: set while the pending effect is a human decision request.",
          "anyOf": [
            {
              "$ref": "#/$defs/WaitingView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "artifact",
        "entry",
        "step",
        "status",
        "root",
        "children",
        "dependencies",
        "admitted_at_ms"
      ]
    },
    "RunsQuery": {
      "description": "X34: the runs list with an optional admission time range. `since_ms` is\ninclusive and `until_ms` exclusive; either may be omitted.",
      "type": "object",
      "properties": {
        "after": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "maximum": 25,
          "minimum": 1
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "since_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "minimum": 0
        },
        "until_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "StepNode": {
      "type": "object",
      "properties": {
        "edges": {
          "description": "Labelled successors in label order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "invoke, decide, wait, for_each, call, join or return.",
          "type": "string"
        },
        "on_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "description": "Command (invoke) or event (wait) contract name, or `dependency/entry`\n(call). Never inputs, expressions or values.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "edges"
      ]
    },
    "StepTimeline": {
      "description": "X32: steps reachable from the run's entry in breadth-first order from\n`start` (successors by edge label, then `on_error`).",
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepNode"
          }
        }
      },
      "required": [
        "entry",
        "start",
        "steps"
      ]
    },
    "WaitingView": {
      "description": "X33: the run's pending effect is a human `decision.request`.",
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "decision_state": {
          "description": "`pending`, `answered`, `expired` or `cancelled`; null if unrecorded.",
          "type": [
            "string",
            "null"
          ]
        },
        "intent": {
          "type": "string"
        },
        "kind": {
          "description": "Always `decision` in this version.",
          "type": "string"
        },
        "related_task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "kind",
        "intent",
        "decision_id",
        "related_task_ids"
      ]
    }
  }
}
