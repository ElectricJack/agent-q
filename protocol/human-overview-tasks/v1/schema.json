{
  "type": "object",
  "properties": {
    "contract": {
      "const": "human-overview-tasks-1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string",
                "maxLength": 128
              },
              "revision": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              "workspace_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "id",
              "name",
              "revision",
              "workspace_id"
            ],
            "additionalProperties": false
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_status": {
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "coverage": {
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "count_accuracy": {
            "enum": [
              "complete_observation",
              "lower_bound",
              "unknown"
            ]
          },
          "task_counts": {
            "type": "object",
            "properties": {
              "draft": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "active": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "completed": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "canceled": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "draft",
              "active",
              "completed",
              "canceled"
            ],
            "additionalProperties": false
          },
          "tasks": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "version": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,18}$"
                },
                "content_revision": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,18}$"
                },
                "task_state": {
                  "enum": [
                    "draft",
                    "active",
                    "completed",
                    "canceled"
                  ]
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "title",
                "version",
                "content_revision",
                "task_state",
                "updated_at"
              ],
              "additionalProperties": false
            }
          },
          "more_tasks": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "unsupported_adapter",
                  "budget_exhausted",
                  "invalid_graph_response",
                  "graph_unavailable",
                  "read_timeout"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "project",
          "observed_at",
          "source_status",
          "coverage",
          "count_accuracy",
          "task_counts",
          "tasks",
          "more_tasks",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "source_status": {
                  "const": "unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "observed_at": {
                  "type": "null"
                },
                "coverage": {
                  "const": "unavailable"
                },
                "count_accuracy": {
                  "const": "unknown"
                },
                "task_counts": {
                  "properties": {
                    "draft": {
                      "type": "null"
                    },
                    "active": {
                      "type": "null"
                    },
                    "completed": {
                      "type": "null"
                    },
                    "canceled": {
                      "type": "null"
                    }
                  }
                },
                "tasks": {
                  "maxItems": 0
                },
                "more_tasks": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "coverage": {
                  "enum": [
                    "complete",
                    "partial"
                  ]
                },
                "count_accuracy": {
                  "enum": [
                    "complete_observation",
                    "lower_bound"
                  ]
                },
                "task_counts": {
                  "properties": {
                    "draft": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "active": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "completed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    "canceled": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    }
                  }
                },
                "more_tasks": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "count_accuracy": {
                  "const": "complete_observation"
                }
              }
            },
            "then": {
              "properties": {
                "coverage": {
                  "const": "complete"
                },
                "more_tasks": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "count_accuracy": {
                  "const": "lower_bound"
                }
              }
            },
            "then": {
              "properties": {
                "coverage": {
                  "const": "partial"
                },
                "more_tasks": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "next_after": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "enum": [
        "complete",
        "partial"
      ]
    }
  },
  "required": [
    "contract",
    "observed_at",
    "scope",
    "projects",
    "next_after",
    "coverage"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded human Overview task contributions v1"
}
