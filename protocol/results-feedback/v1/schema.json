{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wire",
  "anyOf": [
    {
      "$ref": "#/$defs/Follow"
    },
    {
      "$ref": "#/$defs/Comment"
    },
    {
      "$ref": "#/$defs/Correction"
    },
    {
      "$ref": "#/$defs/Resolve"
    },
    {
      "$ref": "#/$defs/FeedbackDraft"
    },
    {
      "$ref": "#/$defs/FeedbackLink"
    },
    {
      "$ref": "#/$defs/Waiver"
    },
    {
      "$ref": "#/$defs/CapturePolicy"
    },
    {
      "$ref": "#/$defs/Envelope"
    },
    {
      "$ref": "#/$defs/Detail"
    },
    {
      "$ref": "#/$defs/Envelope2"
    },
    {
      "$ref": "#/$defs/Envelope3"
    },
    {
      "$ref": "#/$defs/Envelope4"
    }
  ],
  "$defs": {
    "Anchor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "result"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "format": "uuid"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "height": {
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "image_region"
            },
            "width": {
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": 0
            },
            "x": {
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": 0
            },
            "y": {
              "type": "number",
              "format": "double",
              "maximum": 1,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "artifact_id",
            "digest",
            "x",
            "y",
            "width",
            "height"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "format": "uuid"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "end_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "video_range"
            },
            "start_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "artifact_id",
            "digest",
            "start_ms",
            "end_ms"
          ]
        }
      ]
    },
    "ApiVersion": {
      "type": "string",
      "enum": [
        "dashboard-read-1"
      ]
    },
    "ArtifactPin": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "digest"
      ]
    },
    "CapturePolicy": {
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptureRequirement"
          }
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "requirements"
      ]
    },
    "CaptureRequirement": {
      "type": "object",
      "properties": {
        "applicability": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "environment": {
          "type": "string"
        },
        "gate_binding": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "policy_revision": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "scenario": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "viewport": {
          "$ref": "#/$defs/Viewport"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "policy_revision",
        "kind",
        "scenario",
        "steps",
        "viewport",
        "environment",
        "count",
        "required",
        "applicability",
        "gate_binding"
      ]
    },
    "Comment": {
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "body": {
          "type": "string",
          "maxLength": 16384,
          "minLength": 1
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "follow": {
          "type": "boolean",
          "default": false
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_version",
        "body",
        "anchor",
        "result_id",
        "revision"
      ]
    },
    "CommentProjection": {
      "type": "object",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "author_id": {
          "type": "string",
          "format": "uuid"
        },
        "body": {
          "type": "string"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "feedback_links": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FeedbackLinkProjection"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommentRevision"
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision": {
          "type": "string"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_state": {
          "type": "string"
        },
        "thread_version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "revision",
        "thread_id",
        "thread_version",
        "thread_state",
        "body",
        "author_id",
        "created_at_ms",
        "anchor",
        "history"
      ]
    },
    "CommentRevision": {
      "type": "object",
      "properties": {
        "author_id": {
          "type": "string",
          "format": "uuid"
        },
        "body": {
          "type": "string"
        },
        "recorded_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "revision",
        "body",
        "author_id",
        "recorded_at_ms"
      ]
    },
    "CommentsPage": {
      "type": "object",
      "properties": {
        "feedback_read_version": {
          "$ref": "#/$defs/FeedbackReadVersion",
          "default": "results-feedback-1"
        },
        "follow_up_submission": {
          "$ref": "#/$defs/FollowUpSubmission",
          "default": {
            "state": "unsupported"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommentProjection"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "items"
      ]
    },
    "Completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "Correction": {
      "type": "object",
      "properties": {
        "body": {
          "type": "string",
          "maxLength": 16384,
          "minLength": 1
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_version",
        "body"
      ]
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/Completeness"
        }
      },
      "additionalProperties": false,
      "required": [
        "state"
      ]
    },
    "Detail": {
      "type": "object",
      "properties": {
        "assessment": {
          "$ref": "#/$defs/ResultAssessment"
        },
        "feedback_read_version": {
          "$ref": "#/$defs/FeedbackReadVersion",
          "default": "results-feedback-1"
        },
        "follow_up_submission": {
          "$ref": "#/$defs/FollowUpSubmission",
          "default": {
            "state": "unsupported"
          }
        },
        "result": {
          "$ref": "#/$defs/ResultProjection"
        },
        "revision": {
          "$ref": "#/$defs/ResultRevision"
        }
      },
      "additionalProperties": false,
      "required": [
        "result",
        "revision",
        "assessment"
      ]
    },
    "Disposition": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "conflict",
        "rejected",
        "unknown"
      ]
    },
    "Envelope": {
      "type": "object",
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ApiVersion"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "data": {
          "$ref": "#/$defs/FeedbackTaskStatus"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "pending_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "server_time": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "server_time",
        "scope",
        "data",
        "observation",
        "pending_operations",
        "coverage"
      ]
    },
    "Envelope2": {
      "type": "object",
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ApiVersion"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "data": {
          "$ref": "#/$defs/ResultsPage"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "pending_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "server_time": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "server_time",
        "scope",
        "data",
        "observation",
        "pending_operations",
        "coverage"
      ]
    },
    "Envelope3": {
      "type": "object",
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ApiVersion"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "data": {
          "$ref": "#/$defs/CommentsPage"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "pending_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "server_time": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "server_time",
        "scope",
        "data",
        "observation",
        "pending_operations",
        "coverage"
      ]
    },
    "Envelope4": {
      "type": "object",
      "properties": {
        "api_version": {
          "$ref": "#/$defs/ApiVersion"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "data": {
          "$ref": "#/$defs/Detail"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        },
        "pending_operations": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "server_time": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "server_time",
        "scope",
        "data",
        "observation",
        "pending_operations",
        "coverage"
      ]
    },
    "Evaluation": {
      "type": "object",
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementEvaluation"
          }
        },
        "satisfied": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "satisfied",
        "requirements"
      ]
    },
    "FeedbackDraft": {
      "type": "object",
      "properties": {
        "acceptance_criteria": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactPin"
          },
          "maxItems": 20
        },
        "comment_id": {
          "type": "string",
          "format": "uuid"
        },
        "comment_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "description": {
          "type": "string"
        },
        "expected_project_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_version",
        "result_id",
        "revision",
        "thread_id",
        "comment_id",
        "comment_revision",
        "title",
        "description",
        "acceptance_criteria",
        "project_id",
        "expected_project_revision",
        "artifacts"
      ]
    },
    "FeedbackLink": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactPin"
          },
          "maxItems": 20
        },
        "comment_id": {
          "type": "string",
          "format": "uuid"
        },
        "comment_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_version",
        "result_id",
        "revision",
        "thread_id",
        "comment_id",
        "comment_revision",
        "project_id",
        "task_id",
        "artifacts"
      ]
    },
    "FeedbackLinkProjection": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/FeedbackOrigin"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "project_id",
        "task_id",
        "origin"
      ]
    },
    "FeedbackOrigin": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactPin"
          },
          "maxItems": 20
        },
        "comment_id": {
          "type": "string",
          "format": "uuid"
        },
        "comment_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "result_id",
        "revision",
        "thread_id",
        "comment_id",
        "comment_revision",
        "artifacts"
      ]
    },
    "FeedbackReadVersion": {
      "description": "Additive read contract revision; missing markers identify legacy v1 responses.",
      "type": "string",
      "enum": [
        "results-feedback-1",
        "results-feedback-1.1"
      ]
    },
    "FeedbackTaskStatus": {
      "type": "object",
      "properties": {
        "creation_disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "link_confirmed": {
          "type": "boolean"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/FeedbackDraft"
        },
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "string"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "task_id",
        "creation_disposition",
        "link_confirmed",
        "result_id",
        "revision",
        "origin"
      ]
    },
    "Follow": {
      "type": "object",
      "properties": {
        "expected_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "following": {
          "type": "boolean"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_version",
        "following"
      ]
    },
    "FollowUpSubmission": {
      "description": "No submission owner exists yet. Links and resolution never imply submission.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unsupported"
            }
          },
          "additionalProperties": false,
          "required": [
            "state"
          ]
        }
      ]
    },
    "ObjectFormat": {
      "type": "string",
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "ObjectId": {
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/ObjectFormat"
        },
        "hex": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "format",
        "hex"
      ]
    },
    "Observation": {
      "type": "object",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/Completeness"
        },
        "fresh_until": {
          "$ref": "#/$defs/Timestamp"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "observed_at",
        "fresh_until",
        "source",
        "quality",
        "coverage"
      ]
    },
    "ProcessOutcome": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "cancelled",
        "expired",
        "unknown"
      ]
    },
    "Quality": {
      "type": "string",
      "enum": [
        "reported",
        "unknown"
      ]
    },
    "RequirementEvaluation": {
      "type": "object",
      "properties": {
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "policy_revision": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "requirement_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "waiver_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "policy_revision",
        "required",
        "state",
        "artifact_ids"
      ]
    },
    "Resolve": {
      "type": "object",
      "properties": {
        "expected_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "follow_up": {
          "$ref": "#/$defs/RevisionRef"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_version",
        "follow_up",
        "reason"
      ]
    },
    "ResultAssessment": {
      "type": "object",
      "properties": {
        "acceptance": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactPin"
          },
          "maxItems": 20
        },
        "evidence": {
          "$ref": "#/$defs/Evaluation"
        },
        "observed_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "result_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unresolved_review": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "result_revision",
        "evidence",
        "artifacts",
        "acceptance",
        "observed_at_ms",
        "unresolved_review"
      ]
    },
    "ResultProjection": {
      "description": "Result identity and principal preference, independent of mutable assessment.",
      "type": "object",
      "properties": {
        "current_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "directly_following": {
          "description": "Direct principal preference, independent of thread opt-in membership.",
          "type": "boolean",
          "default": false
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "project_id",
        "task_id",
        "current_revision"
      ]
    },
    "ResultRevision": {
      "type": "object",
      "properties": {
        "addressed_feedback": {
          "description": "Compatibility projection of thread IDs explicitly resolved against this revision.\nThis supplemental observation is not part of the immutable native report.",
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactPin"
          },
          "maxItems": 20
        },
        "attempt_id": {
          "type": "string",
          "format": "uuid"
        },
        "capture_policy": {
          "$ref": "#/$defs/CapturePolicy"
        },
        "check_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "parent_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RevisionRef"
          }
        },
        "process_outcome": {
          "description": "The worker-reported process outcome; absent from older servers.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "report_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "submitted_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "summary": {
          "description": "The worker's conclusion, as recorded in the native report.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "report_id",
        "revision",
        "attempt_id",
        "source",
        "summary",
        "submitted_at_ms",
        "parent_results",
        "capture_policy",
        "artifacts",
        "check_refs",
        "evidence_refs",
        "addressed_feedback"
      ]
    },
    "ResultsPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Detail"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "items"
      ]
    },
    "RevisionRef": {
      "type": "object",
      "properties": {
        "result_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "result_id",
        "revision"
      ]
    },
    "Scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all_authorized"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "project"
            },
            "project_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "project_id"
          ]
        }
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/ObjectId"
        },
        "repository_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository_id",
        "base"
      ]
    },
    "ThreadResolution": {
      "type": "object",
      "properties": {
        "follow_up": {
          "$ref": "#/$defs/RevisionRef"
        },
        "follow_up_report_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string"
        },
        "resolved_by": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "resolved_by",
        "reason",
        "follow_up",
        "follow_up_report_id"
      ]
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "Viewport": {
      "type": "object",
      "properties": {
        "dpr_milli": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height_css": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width_css": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "width_css",
        "height_css",
        "dpr_milli"
      ]
    },
    "Waiver": {
      "type": "object",
      "properties": {
        "expected_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "policy_revision": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "requirement_id": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "operation_id",
        "expected_version",
        "revision",
        "requirement_id",
        "policy_revision",
        "reason"
      ]
    }
  }
}
