{
  "$defs": {
    "AccountingState": {
      "enum": [
        "unavailable"
      ],
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "request",
        "policy",
        "compatibility",
        "compiler",
        "renderer",
        "composition",
        "mail_frame",
        "startup"
      ],
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "AuthorityState": {
      "enum": [
        "none"
      ],
      "type": "string"
    },
    "AuthorityState2": {
      "enum": [
        "none"
      ],
      "type": "string"
    },
    "AuthorizedCredential": {
      "additionalProperties": false,
      "description": "Operator authority to provision a specific profile/account/endpoint. Presence\nis separate from the node's installed binding and provider availability.",
      "properties": {
        "account_reference": {
          "type": "string"
        },
        "allowed_backends": {
          "description": "Derived from the operator credential profile, independently of node bindings.",
          "items": {
            "$ref": "#/$defs/BackendKind"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "endpoint_reference": {
          "type": "string"
        },
        "material_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "provider": {
          "type": "string"
        },
        "provisionable": {
          "type": "boolean"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "profile",
        "provider",
        "account_reference",
        "endpoint_reference",
        "revision",
        "enabled",
        "provisionable"
      ],
      "type": "object"
    },
    "Availability": {
      "enum": [
        "available",
        "quota_unavailable",
        "temporary_unavailable",
        "authentication_failed",
        "model_unsupported"
      ],
      "type": "string"
    },
    "AvailabilityObservation": {
      "additionalProperties": false,
      "properties": {
        "cooldown_until_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "observation_id": {
          "format": "uuid",
          "type": "string"
        },
        "received_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/ObservationScope"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/ObservationSource"
        },
        "state": {
          "$ref": "#/$defs/Availability"
        }
      },
      "required": [
        "observation_id",
        "scope",
        "source",
        "sequence",
        "revision",
        "state",
        "received_at_ms",
        "expires_at_ms",
        "cooldown_until_ms"
      ],
      "type": "object"
    },
    "BackendKind": {
      "enum": [
        "docker-local",
        "boat",
        "cloudflare-containers"
      ],
      "type": "string"
    },
    "BudgetBasis": {
      "enum": [
        "task_cumulative_estimated_cost",
        "task_cumulative_enforced_cost"
      ],
      "type": "string"
    },
    "CandidateState": {
      "enum": [
        "eligible",
        "missing_credentials",
        "unavailable",
        "unsupported",
        "stale_unknown",
        "policy_denied"
      ],
      "type": "string"
    },
    "CandidateTrace": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "credential_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        "profile_candidate_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/CandidateState"
        }
      },
      "required": [
        "candidate_id",
        "profile_candidate_id",
        "provider",
        "model",
        "harness",
        "environment",
        "state",
        "reason_codes",
        "observation_ids"
      ],
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "CentralAttemptPolicy": {
      "enum": [
        "initial_selection_only"
      ],
      "type": "string"
    },
    "CentralBundle": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/GeneratedArtifact"
        },
        "compatibility": {
          "$ref": "#/$defs/GeneratedArtifact"
        },
        "compiler": {
          "$ref": "#/$defs/GeneratedArtifact"
        },
        "composition": {
          "$ref": "#/$defs/CentralComposition"
        },
        "mail_frame": {
          "$ref": "#/$defs/GeneratedArtifact"
        },
        "policy": {
          "$ref": "#/$defs/GeneratedArtifact"
        },
        "renderer": {
          "$ref": "#/$defs/GeneratedArtifact"
        },
        "request": {
          "$ref": "#/$defs/GeneratedArtifact"
        },
        "startup": {
          "$ref": "#/$defs/GeneratedArtifact"
        }
      },
      "required": [
        "composition",
        "request",
        "policy",
        "compatibility",
        "compiler",
        "renderer",
        "mail_frame",
        "startup",
        "artifact"
      ],
      "type": "object"
    },
    "CentralChoice": {
      "additionalProperties": false,
      "properties": {
        "account_reference": {
          "type": "string"
        },
        "candidate_id": {
          "type": "string"
        },
        "composition": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "credential_profile": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "credential_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "endpoint_reference": {
          "type": "string"
        },
        "harness_settings": {
          "$ref": "#/$defs/HarnessSettings"
        },
        "model_settings": {
          "$ref": "#/$defs/ModelSettings"
        },
        "profile_candidate_id": {
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "reasoning_configuration_reference": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/$defs/ResourceCeilings"
        },
        "startup": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "candidate_id",
        "profile_candidate_id",
        "model_settings",
        "reasoning_configuration_reference",
        "harness_settings",
        "qualification",
        "credential_profile",
        "credential_revision",
        "account_reference",
        "endpoint_reference",
        "composition",
        "startup",
        "resources"
      ],
      "type": "object"
    },
    "CentralComposition": {
      "additionalProperties": false,
      "properties": {
        "agent_profile": {
          "$ref": "#/$defs/Source"
        },
        "authority": {
          "$ref": "#/$defs/AuthorityState"
        },
        "catalog": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "compatibility": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "compiler": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "context_limit_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cost": {
          "type": "null"
        },
        "denied_requirements": {
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "type": "array"
        },
        "effective_permissions": {
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "type": "array"
        },
        "environment": {
          "type": "string"
        },
        "execution_profile": {
          "$ref": "#/$defs/Source"
        },
        "harness": {
          "type": "string"
        },
        "instruction_order": {
          "items": {
            "$ref": "#/$defs/Instruction"
          },
          "type": "array"
        },
        "intelligence_profile": {
          "$ref": "#/$defs/Source"
        },
        "mail_frame": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "modules": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 128,
          "type": "array"
        },
        "omissions": {
          "items": {
            "$ref": "#/$defs/Omission"
          },
          "type": "array"
        },
        "optional_startup_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "overrides": {
          "items": {
            "$ref": "#/$defs/OverrideExplanation"
          },
          "type": "array"
        },
        "reference_material": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "type": "array"
        },
        "renderer": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "request": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "requested_permissions": {
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "type": "array"
        },
        "required_startup_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "format": "uint32",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "selected_model": {
          "type": "null"
        },
        "selection": {
          "$ref": "#/$defs/SelectionState"
        },
        "startup": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "startup_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "subject": {
          "$ref": "#/$defs/CentralProfileSubject"
        },
        "token_count": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "subject",
        "request",
        "catalog",
        "compiler",
        "compatibility",
        "renderer",
        "mail_frame",
        "agent_profile",
        "intelligence_profile",
        "execution_profile",
        "modules",
        "harness",
        "environment",
        "instruction_order",
        "requested_permissions",
        "effective_permissions",
        "denied_requirements",
        "context_limit_bytes",
        "required_startup_bytes",
        "optional_startup_bytes",
        "omissions",
        "overrides",
        "reference_material",
        "startup",
        "startup_bytes",
        "selection",
        "selected_model",
        "token_count",
        "cost",
        "authority"
      ],
      "type": "object"
    },
    "CentralCredentialBinding": {
      "additionalProperties": false,
      "description": "Installed local presence data only; no worker delivery/preparation target.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "credential_profile": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "credential_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "observed_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "credential_revision",
        "credential_profile",
        "available",
        "observed_at_ms",
        "expires_at_ms"
      ],
      "type": "object"
    },
    "CentralPolicyKind": {
      "enum": [
        "central_turn_selection"
      ],
      "type": "string"
    },
    "CentralProfileSubject": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "actor_id": {
              "format": "uuid",
              "type": "string"
            },
            "conversation_id": {
              "format": "uuid",
              "type": "string"
            },
            "conversation_revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "central_conversation",
              "type": "string"
            },
            "policy": {
              "$ref": "#/$defs/ArtifactRef"
            }
          },
          "required": [
            "kind",
            "actor_id",
            "conversation_id",
            "conversation_revision",
            "policy"
          ],
          "type": "object"
        }
      ]
    },
    "CentralSelectionArtifact": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "selection": {
          "$ref": "#/$defs/ResolvedCentralSelection"
        },
        "utf8": {
          "type": "string"
        }
      },
      "required": [
        "reference",
        "utf8",
        "selection"
      ],
      "type": "object"
    },
    "CentralSelectionInputs": {
      "additionalProperties": false,
      "properties": {
        "compositions": {
          "items": {
            "$ref": "#/$defs/CentralBundle"
          },
          "type": "array"
        },
        "installation": {
          "$ref": "#/$defs/Pinned5"
        },
        "now_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "original_expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "policy": {
          "$ref": "#/$defs/Pinned3"
        },
        "registry": {
          "$ref": "#/$defs/Pinned4"
        },
        "reservation": {
          "$ref": "#/$defs/Pinned"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "reservation",
        "policy",
        "registry",
        "installation",
        "compositions",
        "now_ms",
        "original_expires_at_ms"
      ],
      "type": "object"
    },
    "CentralSelectionOutcome": {
      "additionalProperties": false,
      "properties": {
        "accounting": {
          "$ref": "#/$defs/AccountingState"
        },
        "authority": {
          "$ref": "#/$defs/AuthorityState2"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/CentralSelectionArtifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "spent_microunits": {
          "type": "null"
        },
        "token_count": {
          "type": "null"
        },
        "traces": {
          "items": {
            "$ref": "#/$defs/CandidateTrace"
          },
          "type": "array"
        }
      },
      "required": [
        "traces",
        "reason_codes",
        "accounting",
        "token_count",
        "spent_microunits",
        "authority"
      ],
      "type": "object"
    },
    "CentralTurnPolicy": {
      "additionalProperties": false,
      "properties": {
        "agent_profile": {
          "$ref": "#/$defs/Source"
        },
        "allow_unknown_cost": {
          "type": "boolean"
        },
        "allowed_environments": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "attempts": {
          "$ref": "#/$defs/CentralAttemptPolicy"
        },
        "catalog": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "ceilings": {
          "$ref": "#/$defs/ResourceCeilings"
        },
        "compatibility": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "composition_policy": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "enabled": {
          "type": "boolean"
        },
        "execution_profile": {
          "$ref": "#/$defs/Source"
        },
        "intelligence_profile": {
          "$ref": "#/$defs/Source"
        },
        "kind": {
          "$ref": "#/$defs/CentralPolicyKind"
        },
        "max_output_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reservation": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "reservation_policy": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "subject": {
          "$ref": "#/$defs/CentralProfileSubject"
        }
      },
      "required": [
        "schema_version",
        "revision",
        "kind",
        "subject",
        "reservation",
        "reservation_policy",
        "composition_policy",
        "compatibility",
        "catalog",
        "agent_profile",
        "intelligence_profile",
        "execution_profile",
        "enabled",
        "attempts",
        "allow_unknown_cost",
        "ceilings",
        "max_output_tokens",
        "allowed_environments"
      ],
      "type": "object"
    },
    "Delivery": {
      "enum": [
        "startup",
        "on_demand"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "GeneratedArtifact": {
      "additionalProperties": false,
      "description": "Actual generated UTF-8 data, never retained storage or authenticated authority.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "reference": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "utf8": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reference",
        "utf8"
      ],
      "type": "object"
    },
    "HarnessSettings": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "cli_version": {
          "$ref": "#/$defs/Text"
        },
        "environment": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "harness": {
          "$ref": "#/$defs/Text"
        },
        "required_capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        }
      },
      "required": [
        "harness",
        "cli_version",
        "adapter",
        "environment",
        "required_capabilities"
      ],
      "type": "object"
    },
    "InstallationSnapshot": {
      "additionalProperties": false,
      "description": "Local installation incarnation, deliberately not a Run generation or worker.",
      "properties": {
        "credential_bindings": {
          "items": {
            "$ref": "#/$defs/CentralCredentialBinding"
          },
          "type": "array"
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "harnesses": {
          "items": {
            "$ref": "#/$defs/InstalledHarness"
          },
          "type": "array"
        },
        "incarnation_id": {
          "format": "uuid",
          "type": "string"
        },
        "installation_id": {
          "format": "uuid",
          "type": "string"
        },
        "observed_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "installation_id",
        "incarnation_id",
        "revision",
        "observed_at_ms",
        "expires_at_ms",
        "harnesses",
        "credential_bindings"
      ],
      "type": "object"
    },
    "InstalledHarness": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        },
        "cli_version": {
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "failure_classifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness": {
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/NativeLimits"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/NativeModelSupport"
          },
          "type": "array"
        },
        "qualification": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "harness",
        "cli_version",
        "adapter",
        "environment",
        "qualification",
        "models",
        "capabilities",
        "limits"
      ],
      "type": "object"
    },
    "Instruction": {
      "additionalProperties": false,
      "properties": {
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "required": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "delivery",
        "required",
        "text"
      ],
      "type": "object"
    },
    "ModelSettings": {
