    {
      "id": "enrollment",
      "method": "POST",
      "path": "/v1/worker/enroll",
      "bearer_required": false,
      "request": {
        "code": "synthetic-enrollment-code",
        "name": "fixture-node",
        "worker_version": "0.1.0",
        "protocol_version": 1
      },
      "response_status": 200,
      "response": {
        "node_id": "11111111-1111-4111-8111-111111111111",
        "credential": "aqn_fixture-not-valid",
        "heartbeat_interval_secs": 15
      },
      "assertions": [
        "Code is single-use and expires after its configured lifetime (default 600 seconds).",
        "Only a verifier is retained centrally."
      ]
    },
    {
      "id": "heartbeat",
      "method": "POST",
      "path": "/v1/worker/heartbeat",
      "bearer_required": true,
      "request": {
        "worker_version": "0.1.0",
        "protocol_version": 1
      },
      "response_status": 200,
      "response": {
        "server_version": "0.1.0",
        "heartbeat_interval_secs": 15
      },
      "assertions": [
        "Authenticated stable node ID remains unchanged across daemon/database restart.",
        "last_seen_at advances; heartbeat conveys no execution authority."
      ]
    },
    {
      "id": "probe",
      "method": "POST",
      "path": "/v1/worker/probe",
      "bearer_required": true,
      "request": {
        "nonce": "fixture-nonce"
      },
      "response_status": 200,
      "response": {
        "nonce": "fixture-nonce",
        "server_time": "2026-10-30T12:00:00Z"
      },
      "assertions": [
        "Nonce longer than 64 characters yields 400 bad_request."
      ]
    },
    {
      "id": "credential-revoked",
      "method": "POST",
      "path": "/v1/worker/heartbeat",
      "bearer_required": true,
      "request": {
        "worker_version": "0.1.0",
        "protocol_version": 1
      },
      "response_status": 401,
      "response": {
        "error": "credential_revoked",
        "message": "this worker credential has been revoked; enroll the worker again"
      },
      "assertions": [
        "Same error code applies to probe.",
        "Does not update last_seen_at.",
        "Worker run loop terminates instead of retrying.",
        "Message text is informational; status and error code are compatibility assertions."
      ]
    },
    {
      "id": "unsupported-protocol",
      "method": "POST",
      "path": "/v1/worker/heartbeat",
      "bearer_required": true,
      "request": {
        "worker_version": "0.1.0",
        "protocol_version": 99
      },
      "response_status": 426,
      "response": {
        "error": "unsupported_protocol",
        "message": "worker protocol 99 is not supported; this server accepts 1–1. Install a compatible aq-worker release.",
        "supported_min": 1,
        "supported_max": 1
      },
      "assertions": [
        "Protocol rejection precedes credential validation.",
        "Incompatible enrollment does not consume its code."
      ]
    }
  ],
