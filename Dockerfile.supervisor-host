# F1a standalone host. E1c production orchestration and provider qualification
# are separate gates; supply the exact native executable as a read-only mount.
FROM rust:1.96.1-bookworm@sha256:a339861ae23e9abb272cea45dfafde21760d2ce6577a70f8a926153677902663 AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY vendor ./vendor
COPY protocol ./protocol
RUN echo 'e68ad4071935cec0bf7d67b5ab52e5e30364c12869e8e6b99b964b8fd69f3f1a  vendor/aq-session-host-0.1.6-source.tar.gz' | sha256sum -c -
RUN mkdir /pinned && tar -xzf vendor/aq-session-host-0.1.6-source.tar.gz -C /pinned --strip-components=1 \
    && diff -r /pinned/crates/aq-session-host/src vendor/aq-session-host-0.1.6/src \
    && diff -r /pinned/crates/aq-codex-mapper/src vendor/aq-codex-mapper-0.1.1/src \
    && diff -r /pinned/crates/aq-responses-transport/src vendor/aq-responses-transport-0.1.0/src
ENV CARGO_BUILD_JOBS=2
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=aq-supervisor-host-release,sharing=locked,target=/build/target \
    cargo build --locked --release -p aq-supervisor-host --bins \
    && mkdir /out && cp target/release/aq-supervisor-host target/release/aq-session-host /out/
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tmux libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 native && useradd --uid 10001 --gid native --no-create-home native \
    && install -d -m 700 /host \
    && install -d -m 711 /native-homes \
    && install -d -m 700 -o 10001 -g 10001 /workspace
COPY --from=build /out/aq-supervisor-host /usr/local/bin/aq-supervisor-host
COPY --from=build /out/aq-session-host /usr/local/bin/aq-session-host
# Root owns transport/credential; only the native child runs as 10001.
# Run in a private PID namespace without a Docker socket or privileged mode.
USER 0:0
ENTRYPOINT ["/usr/local/bin/aq-supervisor-host"]
CMD ["run", "/config/supervisor.json"]
